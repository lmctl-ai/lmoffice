# Corporate annual report presentation with financial overview, multi-year table, and 5-year growth chart.
output = ARGV.len() > 0 ? ARGV[0] : "annual_report.pptx";
p = _lmcode_ cli="lmoffice pptx" install="github:lmctl-ai/lmoffice@latest";
let deck = pptx.create(${output});
deck.theme("#1F4E78", "#548235", "Segoe UI", "Calibri");

# Slide 1: Title
let s1 = deck.slide();
s1.title_slide("2026 Annual Report", "Fiscal Year Performance, Technology Innovation & Sustainable Growth\nNovaterra Technologies Inc. | Annual General Meeting");
s1.footer("Novaterra Technologies 2026 Annual Report");
s1.transition("fade");

# Slide 2: Letter from Leadership / Highlights
let s2 = deck.slide();
s2.title("Fiscal 2026: A Defining Year of Scale and Impact");
s2.rounded_rect(80.0, 160.0, 340.0, 150.0, "#1F4E78", "$210M Total Revenue\n+48% Year-over-Year Growth Across Core Product Lines");
s2.rounded_rect(470.0, 160.0, 340.0, 150.0, "#2E75B6", "100% Renewable Energy\nAll global data center regions powered by carbon-free energy");
s2.rounded_rect(860.0, 160.0, 340.0, 150.0, "#548235", "$42M Free Cash Flow\nThird consecutive year of profitable, self-sustaining operations");
s2.text(80.0, 360.0, 1100.0, 60.0, "We expanded operations to 14 sovereign cloud regions while maintaining industry-leading 99.999% reliability.");
s2.footer("Novaterra Technologies 2026 Annual Report");
s2.slide_number(true);

# Slide 3: Multi-Year Financial Performance Table
let s3 = deck.slide();
s3.title("Three-Year Financial Summary ($ Millions)");
let tbl = s3.table(80.0, 150.0, 1120.0, 260.0, 5, 4);
tbl.header_row("#1F4E78", "#FFFFFF");
tbl.cell(1, 1, "Financial Metric").cell(1, 2, "FY 2024").cell(1, 3, "FY 2025").cell(1, 4, "FY 2026");
tbl.cell(2, 1, "Total Revenue").cell(2, 2, "$96.5M").cell(2, 3, "$142.0M").cell(2, 4, "$210.2M");
tbl.cell(3, 1, "Gross Profit (Margin %)").cell(3, 2, "$72.4M (75%)").cell(3, 3, "$110.8M (78%)").cell(3, 4, "$170.3M (81%)");
tbl.cell(4, 1, "R&D Investment").cell(4, 2, "$28.0M").cell(4, 3, "$41.5M").cell(4, 4, "$58.2M");
tbl.cell(5, 1, "Free Cash Flow").cell(5, 2, "$12.2M").cell(5, 3, "$24.6M").cell(5, 4, "$42.1M");
s3.footer("Novaterra Technologies 2026 Annual Report");
s3.slide_number(true);

# Slide 4: 5-Year Revenue Growth Bar Chart
let s4 = deck.slide();
s4.title("Five-Year Revenue Growth Trajectory ($M)");
s4.bar_chart(100.0, 140.0, 1080.0, 460.0, "Annual Revenue ($M)", "FY22,FY23,FY24,FY25,FY26", "Revenue ($M)", "38.5,62.0,96.5,142.0,210.2");
s4.footer("Novaterra Technologies 2026 Annual Report");
s4.slide_number(true);

# Slide 5: Future Outlook
let s5 = deck.slide();
s5.section_header("Looking Ahead: FY 2027 Strategic Roadmap", "Investing in Autonomous AI Mesh, Sovereign Cloud Regions in Asia and Middle East, and Developer Ecosystem", "#1F4E78");
s5.footer("Novaterra Technologies 2026 Annual Report");
s5.slide_number(true);

deck.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--dsl", output + ".dslb"]), 120000);
assert(r.code == 0);
