# A budget workbook with formulas and a formatted summary.
output = ARGV.len() > 0 ? ARGV[0] : "budget.xlsx";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let s = book.sheet("Budget");
s.set(1, 1, "Department").set(1, 2, "Plan").set(1, 3, "Actual").set(1, 4, "Variance");
s.set(2, 1, "Engineering").set(2, 2, 80000.0).set(2, 3, 76000.0).formula(2, 4, "B2-C2");
s.set(3, 1, "Sales").set(3, 2, 45000.0).set(3, 3, 47000.0).formula(3, 4, "B3-C3");
s.set(4, 1, "Operations").set(4, 2, 30000.0).set(4, 3, 28500.0).formula(4, 4, "B4-C4");
s.set(5, 1, "Total").formula(5, 2, "SUM(B2:B4)").formula(5, 3, "SUM(C2:C4)").formula(5, 4, "SUM(D2:D4)");
s.bold(1, 1).bold(1, 2).bold(1, 3).bold(1, 4).bold(5, 1);
s.fill(1, 1, "#D9EAF7").fill(5, 1, "#E8F5E9").number_format(2, 2, "$#,##0.00").number_format(2, 3, "$#,##0.00").number_format(2, 4, "$#,##0.00").number_format(3, 2, "$#,##0.00").number_format(3, 3, "$#,##0.00").number_format(3, 4, "$#,##0.00").number_format(4, 2, "$#,##0.00").number_format(4, 3, "$#,##0.00").number_format(4, 4, "$#,##0.00");
s.col_width(1, 22.0).col_width(2, 14.0).col_width(3, 14.0).col_width(4, 14.0).freeze(1, 0);
s.merge(7, 1, 7, 4).set(7, 1, "Quarterly operating budget");
book.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--dsl", output + ".dslb"]), 120000);
assert(r.code == 0);
