# Facilitated agenda for a quarterly planning workshop.
output = ARGV.len() > 0 ? ARGV[0] : "business-agenda.docx"; p=_lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
let d=docx.create(${output});
d.title("Q3 Planning Workshop Agenda").author("Harborline Devices").font("Calibri").font_size(11.0).margins(54.0,54.0,54.0,54.0);
d.heading("Q3 PLANNING WORKSHOP",1).color("#17324D");
d.paragraph("Harborline Devices · July 8, 2026 · 9:00 a.m.–3:30 p.m. · Alder conference room");
let t=d.table(6,3);
t.borders(true).cell(1,1,"Time").cell(1,2,"Session").cell(1,3,"Owner").cell(2,1,"09:00").cell(2,2,"Quarter review and customer signals").cell(2,3,"Lina Patel").cell(3,1,"10:00").cell(3,2,"Break").cell(3,3,"—").cell(4,1,"10:15").cell(4,2,"Product bets and constraints").cell(4,3,"Priya Nandakumar").cell(5,1,"12:00").cell(5,2,"Working lunch: channel plan").cell(5,3,"Maya Chen").cell(6,1,"13:30").cell(6,2,"Commitments and next steps").cell(6,3,"Morgan Ellis");
d.heading("Preparation",2);
d.bullet("Bring one customer signal and one operational constraint.");
d.bullet("Review the Q2 operating report before the workshop.");
d.bullet("Write proposed Q3 outcomes on the shared board.");
d.footer_fields("Q3 Planning Workshop | {PAGE}/{NUMPAGES}").save();
end _lmcode_
savedsl(p,output+".dslb");
r=system(concat(dsl_cli(p),["--dsl",output+".dslb"]),120000); assert(r.code==0);
