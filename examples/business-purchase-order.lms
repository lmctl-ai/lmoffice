# Purchase order for equipment with delivery terms.
output = ARGV.len() > 0 ? ARGV[0] : "business-purchase-order.docx"; p=_lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
let d=docx.create(${output});
d.title("Purchase Order CP-771").author("Cedar Peak Analytics").font("Calibri").font_size(11.0).page_size(612.0,792.0).orientation("landscape").margins(54.0,54.0,54.0,54.0);
d.heading("PURCHASE ORDER CP-771",1).color("#17324D");
d.paragraph("Buyer: Cedar Peak Analytics · Vendor: Northwind Workshop · Requested delivery: July 12, 2026");
let t=d.table(5,4);
t.column_width(1,360.0).column_width(2,60.0).column_width(3,132.0).column_width(4,132.0);
t.shade(1,1,"#DCE6F1").shade(1,2,"#DCE6F1").shade(1,3,"#DCE6F1").shade(1,4,"#DCE6F1").shade(5,4,"#E7EFF7");
t.borders(true).cell(1,1,"Item").cell(1,2,"Qty").cell(1,3,"Unit price").cell(1,4,"Line total").cell(2,1,"Calibration sensor kit").cell(2,2,"12").cell(2,3,"$1,850").cell(2,4,"$22,200").cell(3,1,"Mounting bracket").cell(3,2,"24").cell(3,3,"$75").cell(3,4,"$1,800").cell(4,1,"Freight").cell(4,2,"1").cell(4,3,"$420").cell(4,4,"$420").cell(5,1,"TOTAL").cell(5,2,"").cell(5,3,"").cell(5,4,"$24,420");
d.heading("Delivery and acceptance",2);
d.paragraph("Ship to Cedar Peak Analytics, Receiving Dock B, 88 Meridian Avenue, Bellwether, OR 97005. Buyer will inspect the shipment within five business days and report visible shortages.");
d.signature("Cedar Peak Analytics");
d.footer_fields("PO CP-771 | {PAGE}/{NUMPAGES}").save();
end _lmcode_
savedsl(p,output+".dslb");
r=system(concat(dsl_cli(p),["--dsl",output+".dslb"]),120000); assert(r.code==0);
