# Fictional project rubric.
output = ARGV.len() > 0 ? ARGV[0] : "education-assessment-rubric.docx";
p=_lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
let d=docx.create(${output}); d.title("Community Data Studio Rubric").author("Northstar Academy").font("Aptos").font_size(10.0).margins(42.0,42.0,42.0,42.0); d.heading("Community data studio rubric",1); d.paragraph("Learner: ____________________   Reviewer: ____________________   Date: __________"); let t=d.table(6,4); t.cell(1,1,"Criterion").cell(1,2,"Exemplary · 4").cell(1,3,"Developing · 3").cell(1,4,"Beginning · 2").cell(2,1,"Question").cell(2,2,"Focused and testable").cell(2,3,"Mostly focused").cell(2,4,"Unclear or broad").cell(3,1,"Evidence").cell(3,2,"Relevant, varied, cited").cell(3,3,"Some relevant evidence").cell(3,4,"Little or uncited").cell(4,1,"Visual").cell(4,2,"Accurate and readable").cell(4,3,"Accurate with gaps").cell(4,4,"Misleading or hard to read").cell(5,1,"Reasoning").cell(5,2,"Connects evidence to claim").cell(5,3,"Partial connection").cell(5,4,"Summary only").cell(6,1,"Reflection").cell(6,2,"Names limits and next step").cell(6,3,"Names one limit").cell(6,4,"No reflection").borders(true).shade(1,1,"#185A80").shade(1,2,"#185A80").shade(1,3,"#185A80").shade(1,4,"#185A80"); t.cell_border(1,1,"bottom","#17324D",12).cell_border(1,2,"bottom","#17324D",12).cell_border(1,3,"bottom","#17324D",12).cell_border(1,4,"bottom","#17324D",12); d.heading("Reviewer notes",2); d.paragraph("Strength: ________________________________________________________________\nNext revision: ____________________________________________________________"); d.paragraph("Total: ______ / 20     Conference date: ____________________"); d.header_fields("Northstar Academy | {PAGE}/{NUMPAGES}").save();
end _lmcode_
savedsl(p,output+".dslb"); r=system(concat(dsl_cli(p),["--dsl",output+".dslb"]),120000); assert(r.code==0);
