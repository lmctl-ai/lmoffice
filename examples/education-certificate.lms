# Fictional completion certificate.
output = ARGV.len() > 0 ? ARGV[0] : "education-certificate.docx";
p=_lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
let d=docx.create(${output}); d.title("Certificate of Completion").author("Northstar Academy").font("Georgia").font_size(12.0).page_size(792.0,612.0).margins(48.0,72.0,48.0,72.0); d.heading("Certificate of completion",1).align("center").color("#185A80"); d.paragraph("This certificate is proudly presented to").align("center"); d.paragraph("Jordan Rivera").align("center").size(26.0).bold(true).color("#17324D"); d.paragraph("for completing the Northstar Academy Community Data Studio, a 24-hour workshop in ethical measurement and clear communication.").align("center"); let t=d.table(6,2); t.cell(1,1,"Program").cell(1,2,"Community Data Studio").cell(2,1,"Completed").cell(2,2,"June 18, 2027").cell(3,1,"Hours").cell(3,2,"24 guided hours").cell(4,1,"Project").cell(4,2,"Neighborhood cooling map").cell(5,1,"Director").cell(5,2,"Morgan Lee").cell(6,1,"Certificate").cell(6,2,"NS-2027-041").borders(true).shade(1,1,"#D9EAF7").shade(1,2,"#D9EAF7"); d.signature("Program director").align("center"); d.signature("Academy registrar").align("center"); d.footer("Northstar Academy · Fictional instructional record"); d.save();
end _lmcode_
savedsl(p,output+".dslb"); r=system(concat(dsl_cli(p),["--lmcode",output+".dslb"]),120000); assert(r.code==0);
