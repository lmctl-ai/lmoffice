# Printable weekly timetable with rooms and study periods All names and figures are fictional.
output = ARGV.len() > 0 ? ARGV[0] : "education-class-schedule.xlsx";
image = output + ".png";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let s = book.sheet("Timetable");
s.merge(1,1,1,6).set(1,1,"Cedar Harbor Learning / weekly timetable").bold(1,1).font_size(1,1,18.0).font_color(1,1,"#FFFFFF").fill(1,1,"#173D55").row_height(1,34.0);
s.merge(2,1,2,6).set(2,1,"Cedar Harbor Group | Planning edition | October 2026").font_color(2,1,"#526675").row_height(2,25.0);
s.col_width(1,20.0).set(4,1,"Time").bold(4,1).fill(4,1,"#D9EAF0").wrap(4,1,true);
s.col_width(2,25.0).set(4,2,"Monday").bold(4,2).fill(4,2,"#D9EAF0").wrap(4,2,true);
s.col_width(3,25.0).set(4,3,"Tuesday").bold(4,3).fill(4,3,"#D9EAF0").wrap(4,3,true);
s.col_width(4,25.0).set(4,4,"Wednesday").bold(4,4).fill(4,4,"#D9EAF0").wrap(4,4,true);
s.col_width(5,25.0).set(4,5,"Thursday").bold(4,5).fill(4,5,"#D9EAF0").wrap(4,5,true);
s.col_width(6,25.0).set(4,6,"Friday").bold(4,6).fill(4,6,"#D9EAF0").wrap(4,6,true);
s.row_height(4,30.0);
s.row_height(5,28.0);
s.set(5,1,"09:00–10:00").wrap(5,1,true).fill(5,1,"#F0F5F7");
s.set(5,2,"Mathematics / 201").wrap(5,2,true).fill(5,2,"#F0F5F7");
s.set(5,3,"Science / Lab A").wrap(5,3,true).fill(5,3,"#F0F5F7");
s.set(5,4,"Mathematics / 201").wrap(5,4,true).fill(5,4,"#F0F5F7");
s.set(5,5,"Science / Lab A").wrap(5,5,true).fill(5,5,"#F0F5F7");
s.set(5,6,"Studio / 104").wrap(5,6,true).fill(5,6,"#F0F5F7");
s.row_height(6,28.0);
s.set(6,1,"10:15–11:15").wrap(6,1,true).fill(6,1,"#FFFFFF");
s.set(6,2,"English / 203").wrap(6,2,true).fill(6,2,"#FFFFFF");
s.set(6,3,"History / 202").wrap(6,3,true).fill(6,3,"#FFFFFF");
s.set(6,4,"English / 203").wrap(6,4,true).fill(6,4,"#FFFFFF");
s.set(6,5,"History / 202").wrap(6,5,true).fill(6,5,"#FFFFFF");
s.set(6,6,"English / 203").wrap(6,6,true).fill(6,6,"#FFFFFF");
s.row_height(7,28.0);
s.set(7,1,"11:30–12:15").wrap(7,1,true).fill(7,1,"#F0F5F7");
s.set(7,2,"Advisory / 101").wrap(7,2,true).fill(7,2,"#F0F5F7");
s.set(7,3,"Design / 104").wrap(7,3,true).fill(7,3,"#F0F5F7");
s.set(7,4,"Advisory / 101").wrap(7,4,true).fill(7,4,"#F0F5F7");
s.set(7,5,"Design / 104").wrap(7,5,true).fill(7,5,"#F0F5F7");
s.set(7,6,"Community / Hall").wrap(7,6,true).fill(7,6,"#F0F5F7");
s.row_height(8,28.0);
s.set(8,1,"12:15–13:00").wrap(8,1,true).fill(8,1,"#FFFFFF");
s.set(8,2,"Lunch").wrap(8,2,true).fill(8,2,"#FFFFFF");
s.set(8,3,"Lunch").wrap(8,3,true).fill(8,3,"#FFFFFF");
s.set(8,4,"Lunch").wrap(8,4,true).fill(8,4,"#FFFFFF");
s.set(8,5,"Lunch").wrap(8,5,true).fill(8,5,"#FFFFFF");
s.set(8,6,"Lunch").wrap(8,6,true).fill(8,6,"#FFFFFF");
s.row_height(9,28.0);
s.set(9,1,"13:00–14:00").wrap(9,1,true).fill(9,1,"#F0F5F7");
s.set(9,2,"Science / Lab A").wrap(9,2,true).fill(9,2,"#F0F5F7");
s.set(9,3,"Mathematics / 201").wrap(9,3,true).fill(9,3,"#F0F5F7");
s.set(9,4,"Music / 105").wrap(9,4,true).fill(9,4,"#F0F5F7");
s.set(9,5,"English / 203").wrap(9,5,true).fill(9,5,"#F0F5F7");
s.set(9,6,"Project lab / 104").wrap(9,6,true).fill(9,6,"#F0F5F7");
s.row_height(10,28.0);
s.set(10,1,"14:15–15:00").wrap(10,1,true).fill(10,1,"#FFFFFF");
s.set(10,2,"Independent study").wrap(10,2,true).fill(10,2,"#FFFFFF");
s.set(10,3,"Sports / Gym").wrap(10,3,true).fill(10,3,"#FFFFFF");
s.set(10,4,"Independent study").wrap(10,4,true).fill(10,4,"#FFFFFF");
s.set(10,5,"Sports / Gym").wrap(10,5,true).fill(10,5,"#FFFFFF");
s.set(10,6,"Weekly reflection").wrap(10,6,true).fill(10,6,"#FFFFFF");
s.border_box(4,1,10,6,"thin","#BCCDD5").freeze(4,0).fit_to_page(1,1).page_orientation("landscape");

book.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--lmcode", output + ".dslb"]), 120000); assert(r.code == 0);
