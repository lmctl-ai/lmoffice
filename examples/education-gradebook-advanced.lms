# Weighted gradebook with native progress icons All names and figures are fictional.
output = ARGV.len() > 0 ? ARGV[0] : "education-gradebook-advanced.xlsx";
image = output + ".png";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let s = book.sheet("Gradebook");
s.merge(1,1,1,5).set(1,1,"Weighted course gradebook").bold(1,1).font_size(1,1,18.0).font_color(1,1,"#FFFFFF").fill(1,1,"#173D55").row_height(1,34.0);
s.merge(2,1,2,5).set(2,1,"Cedar Harbor Group | Planning edition | October 2026").font_color(2,1,"#526675").row_height(2,25.0);
s.col_width(1,24.0).set(4,1,"Learner").bold(4,1).fill(4,1,"#D9EAF0").wrap(4,1,true);
s.col_width(2,18.0).set(4,2,"Projects 40%").bold(4,2).fill(4,2,"#D9EAF0").wrap(4,2,true);
s.col_width(3,18.0).set(4,3,"Labs 30%").bold(4,3).fill(4,3,"#D9EAF0").wrap(4,3,true);
s.col_width(4,18.0).set(4,4,"Exam 30%").bold(4,4).fill(4,4,"#D9EAF0").wrap(4,4,true);
s.col_width(5,18.0).set(4,5,"Weighted %").bold(4,5).fill(4,5,"#D9EAF0").wrap(4,5,true);
s.row_height(4,30.0);
s.row_height(5,28.0);
s.set(5,1,"Avery Chen").wrap(5,1,true).fill(5,1,"#F0F5F7");
s.set(5,2,94).wrap(5,2,true).fill(5,2,"#F0F5F7");
s.set(5,3,91).wrap(5,3,true).fill(5,3,"#F0F5F7");
s.set(5,4,88).wrap(5,4,true).fill(5,4,"#F0F5F7");
s.formula(5,5,"B5*0.4+C5*0.3+D5*0.3").wrap(5,5,true).fill(5,5,"#F0F5F7");
s.row_height(6,28.0);
s.set(6,1,"Morgan Vale").wrap(6,1,true).fill(6,1,"#FFFFFF");
s.set(6,2,82).wrap(6,2,true).fill(6,2,"#FFFFFF");
s.set(6,3,86).wrap(6,3,true).fill(6,3,"#FFFFFF");
s.set(6,4,84).wrap(6,4,true).fill(6,4,"#FFFFFF");
s.formula(6,5,"B6*0.4+C6*0.3+D6*0.3").wrap(6,5,true).fill(6,5,"#FFFFFF");
s.row_height(7,28.0);
s.set(7,1,"Jules Park").wrap(7,1,true).fill(7,1,"#F0F5F7");
s.set(7,2,76).wrap(7,2,true).fill(7,2,"#F0F5F7");
s.set(7,3,81).wrap(7,3,true).fill(7,3,"#F0F5F7");
s.set(7,4,79).wrap(7,4,true).fill(7,4,"#F0F5F7");
s.formula(7,5,"B7*0.4+C7*0.3+D7*0.3").wrap(7,5,true).fill(7,5,"#F0F5F7");
s.row_height(8,28.0);
s.set(8,1,"Riley Ford").wrap(8,1,true).fill(8,1,"#FFFFFF");
s.set(8,2,98).wrap(8,2,true).fill(8,2,"#FFFFFF");
s.set(8,3,96).wrap(8,3,true).fill(8,3,"#FFFFFF");
s.set(8,4,95).wrap(8,4,true).fill(8,4,"#FFFFFF");
s.formula(8,5,"B8*0.4+C8*0.3+D8*0.3").wrap(8,5,true).fill(8,5,"#FFFFFF");
s.row_height(9,28.0);
s.set(9,1,"Sam Ortega").wrap(9,1,true).fill(9,1,"#F0F5F7");
s.set(9,2,69).wrap(9,2,true).fill(9,2,"#F0F5F7");
s.set(9,3,74).wrap(9,3,true).fill(9,3,"#F0F5F7");
s.set(9,4,77).wrap(9,4,true).fill(9,4,"#F0F5F7");
s.formula(9,5,"B9*0.4+C9*0.3+D9*0.3").wrap(9,5,true).fill(9,5,"#F0F5F7");
s.row_height(10,28.0);
s.set(10,1,"Robin Shaw").wrap(10,1,true).fill(10,1,"#FFFFFF");
s.set(10,2,88).wrap(10,2,true).fill(10,2,"#FFFFFF");
s.set(10,3,90).wrap(10,3,true).fill(10,3,"#FFFFFF");
