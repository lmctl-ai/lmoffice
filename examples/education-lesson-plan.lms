# Fictional middle-school lesson plan.
output = ARGV.len() > 0 ? ARGV[0] : "education-lesson-plan.docx";
p=_lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
let d=docx.create(${output});
d.title("Water in a Changing Climate").author("Northstar Academy").font("Aptos").font_size(11.0).margins(54.0,54.0,54.0,54.0); d.heading("Lesson plan: Water in a changing climate",1).color("#17324D"); d.paragraph("Grade 7 science · 55 minutes · Fictional Northstar Academy").bold(true); d.text_box("Essential question: How does warming change the movement of water?",420.0,54.0);
d.heading("Learning targets",2); d.bullet("Describe evaporation, condensation, and precipitation using a model."); d.bullet("Use two observations to support a claim about local water cycles."); d.heading("Sequence",2); let t=d.table(6,3); t.cell(1,1,"Minutes").cell(1,2,"Activity").cell(1,3,"Evidence").cell(2,1,"0–5").cell(2,2,"Launch: puddle photograph").cell(2,3,"Notice / wonder").cell(3,1,"5–15").cell(3,2,"Mini-model of energy transfer").cell(3,3,"Annotated diagram").cell(4,1,"15–30").cell(4,2,"Team investigation").cell(4,3,"Temperature log").cell(5,1,"30–45").cell(5,2,"Claim-evidence-reasoning").cell(5,3,"CER paragraph").cell(6,1,"45–55").cell(6,2,"Exit ticket").cell(6,3,"One next question").borders(true).shade(1,1,"#D9EAF7").shade(1,2,"#D9EAF7").shade(1,3,"#D9EAF7"); d.heading("Materials and supports",2); d.paragraph("Clear cups, ice, thermometers, diagram cards, and sentence frames. Offer a labeled model and partner reading for students who need language support."); d.section_break("landscape"); d.heading("Teacher notes",2); d.paragraph("Listen for the misconception that clouds are made from smoke. Ask students to connect condensation to the cold cup surface and revisit the model during closure.").comment("Review before observation day", "Morgan Lee"); d.header_fields("Northstar Academy | {PAGE} of {NUMPAGES}").save();
end _lmcode_
savedsl(p,output+".dslb"); r=system(concat(dsl_cli(p),["--dsl",output+".dslb"]),120000); assert(r.code==0);
