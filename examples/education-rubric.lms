# Assessment register with score formulas and icon bands All names and figures are fictional.
output = ARGV.len() > 0 ? ARGV[0] : "education-rubric.xlsx";
image = output + ".png";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let s = book.sheet("Assessment");
s.merge(1,1,1,6).set(1,1,"Project assessment / scoring register").bold(1,1).font_size(1,1,18.0).font_color(1,1,"#FFFFFF").fill(1,1,"#173D55").row_height(1,34.0);
s.merge(2,1,2,6).set(2,1,"Cedar Harbor Group | Planning edition | October 2026").font_color(2,1,"#526675").row_height(2,25.0);
s.col_width(1,23.0).set(4,1,"Learner").bold(4,1).fill(4,1,"#D9EAF0").wrap(4,1,true);
s.col_width(2,18.0).set(4,2,"Evidence / 4").bold(4,2).fill(4,2,"#D9EAF0").wrap(4,2,true);
s.col_width(3,18.0).set(4,3,"Reasoning / 4").bold(4,3).fill(4,3,"#D9EAF0").wrap(4,3,true);
s.col_width(4,18.0).set(4,4,"Clarity / 4").bold(4,4).fill(4,4,"#D9EAF0").wrap(4,4,true);
s.col_width(5,18.0).set(4,5,"Total / 12").bold(4,5).fill(4,5,"#D9EAF0").wrap(4,5,true);
s.col_width(6,32.0).set(4,6,"Next step").bold(4,6).fill(4,6,"#D9EAF0").wrap(4,6,true);
s.row_height(4,30.0);
s.row_height(5,28.0);
s.set(5,1,"Avery Chen").wrap(5,1,true).fill(5,1,"#F0F5F7");
s.set(5,2,4).wrap(5,2,true).fill(5,2,"#F0F5F7");
s.set(5,3,3).wrap(5,3,true).fill(5,3,"#F0F5F7");
s.set(5,4,4).wrap(5,4,true).fill(5,4,"#F0F5F7");
s.formula(5,5,"SUM(B5:D5)").wrap(5,5,true).fill(5,5,"#F0F5F7");
s.set(5,6,"Add counterargument").wrap(5,6,true).fill(5,6,"#F0F5F7");
s.row_height(6,28.0);
s.set(6,1,"Morgan Vale").wrap(6,1,true).fill(6,1,"#FFFFFF");
s.set(6,2,3).wrap(6,2,true).fill(6,2,"#FFFFFF");
s.set(6,3,3).wrap(6,3,true).fill(6,3,"#FFFFFF");
s.set(6,4,3).wrap(6,4,true).fill(6,4,"#FFFFFF");
s.formula(6,5,"SUM(B6:D6)").wrap(6,5,true).fill(6,5,"#FFFFFF");
s.set(6,6,"Cite primary sources").wrap(6,6,true).fill(6,6,"#FFFFFF");
s.row_height(7,28.0);
s.set(7,1,"Jules Park").wrap(7,1,true).fill(7,1,"#F0F5F7");
s.set(7,2,2).wrap(7,2,true).fill(7,2,"#F0F5F7");
s.set(7,3,3).wrap(7,3,true).fill(7,3,"#F0F5F7");
s.set(7,4,2).wrap(7,4,true).fill(7,4,"#F0F5F7");
s.formula(7,5,"SUM(B7:D7)").wrap(7,5,true).fill(7,5,"#F0F5F7");
s.set(7,6,"Revise introduction").wrap(7,6,true).fill(7,6,"#F0F5F7");
s.row_height(8,28.0);
s.set(8,1,"Riley Ford").wrap(8,1,true).fill(8,1,"#FFFFFF");
s.set(8,2,4).wrap(8,2,true).fill(8,2,"#FFFFFF");
s.set(8,3,4).wrap(8,3,true).fill(8,3,"#FFFFFF");
s.set(8,4,4).wrap(8,4,true).fill(8,4,"#FFFFFF");
s.formula(8,5,"SUM(B8:D8)").wrap(8,5,true).fill(8,5,"#FFFFFF");
s.set(8,6,"Extend the comparison").wrap(8,6,true).fill(8,6,"#FFFFFF");
s.row_height(9,28.0);
s.set(9,1,"Sam Ortega").wrap(9,1,true).fill(9,1,"#F0F5F7");
s.set(9,2,2).wrap(9,2,true).fill(9,2,"#F0F5F7");
s.set(9,3,2).wrap(9,3,true).fill(9,3,"#F0F5F7");
s.set(9,4,3).wrap(9,4,true).fill(9,4,"#F0F5F7");
s.formula(9,5,"SUM(B9:D9)").wrap(9,5,true).fill(9,5,"#F0F5F7");
s.set(9,6,"Meet during office hours").wrap(9,6,true).fill(9,6,"#F0F5F7");
s.row_height(10,28.0);
s.set(10,1,"Robin Shaw").wrap(10,1,true).fill(10,1,"#FFFFFF");
s.set(10,2,3).wrap(10,2,true).fill(10,2,"#FFFFFF");
s.set(10,3,4).wrap(10,3,true).fill(10,3,"#FFFFFF");
s.set(10,4,3).wrap(10,4,true).fill(10,4,"#FFFFFF");
s.formula(10,5,"SUM(B10:D10)").wrap(10,5,true).fill(10,5,"#FFFFFF");
s.set(10,6,"Tighten conclusion").wrap(10,6,true).fill(10,6,"#FFFFFF");
s.border_box(4,1,10,6,"thin","#BCCDD5").freeze(4,0).fit_to_page(1,1).page_orientation("landscape");
s.conditional_icon_set(5,5,10,5,"3Symbols2");
book.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--lmcode", output + ".dslb"]), 120000); assert(r.code == 0);
