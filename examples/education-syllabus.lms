# Fictional course syllabus.
output = ARGV.len() > 0 ? ARGV[0] : "education-syllabus.docx";
p=_lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
let d=docx.create(${output}); d.title("Applied Data Stories").author("Northstar Academy").font("Aptos").font_size(10.5).margins(54.0,54.0,54.0,54.0); d.heading("Applied data stories",1).color("#17324D"); d.paragraph("Semester syllabus · Spring 2027 · Instructor: Morgan Lee · morgan.lee@northstar.example");  d.heading("Course purpose",2); d.paragraph("Students will turn small datasets into clear questions, visual evidence, and responsible recommendations. All datasets are fictional or classroom-generated."); d.heading("Assessment",2); let t=d.table(6,3); t.cell(1,1,"Work").cell(1,2,"Weight").cell(1,3,"Due").cell(2,1,"Weekly labs").cell(2,2,"25%").cell(2,3,"Fridays").cell(3,1,"Data diary").cell(3,2,"15%").cell(3,3,"Weeks 4, 8").cell(4,1,"Peer critique").cell(4,2,"15%").cell(4,3,"Week 10").cell(5,1,"Final story").cell(5,2,"35%").cell(5,3,"Week 15").cell(6,1,"Participation").cell(6,2,"10%").cell(6,3,"Ongoing").borders(true).shade(1,1,"#D9EAF7").shade(1,2,"#D9EAF7").shade(1,3,"#D9EAF7"); d.heading("Weekly arc",2); d.paragraph("Weeks 1–3: questions and measurement. Weeks 4–6: cleaning and summaries. Weeks 7–9: charts and uncertainty. Weeks 10–12: critique and revision. Weeks 13–15: public showcase."); d.heading("Studio norms",2); d.numbered("Name the source and limits of every number."); d.numbered("Give feedback about evidence before style."); d.numbered("Keep drafts and explain meaningful revisions."); d.header_fields("Applied Data Stories | {PAGE}/{NUMPAGES}").save();
end _lmcode_
savedsl(p,output+".dslb"); r=system(concat(dsl_cli(p),["--lmcode",output+".dslb"]),120000); assert(r.code==0);
