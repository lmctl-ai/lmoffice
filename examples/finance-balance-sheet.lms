# Detailed assets, liabilities and equity with a zero-balance control All names and figures are fictional.
output = ARGV.len() > 0 ? ARGV[0] : "finance-balance-sheet.xlsx";
image = output + ".png";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let s = book.sheet("Balance Sheet");
s.merge(1,1,1,3).set(1,1,"Statement of financial position").bold(1,1).font_size(1,1,18.0).font_color(1,1,"#FFFFFF").fill(1,1,"#173D55").row_height(1,34.0);
s.merge(2,1,2,3).set(2,1,"Cedar Harbor Group | Planning edition | October 2026").font_color(2,1,"#526675").row_height(2,25.0);
s.col_width(1,24.0).set(4,1,"Classification").bold(4,1).fill(4,1,"#D9EAF0").wrap(4,1,true);
s.col_width(2,38.0).set(4,2,"Account").bold(4,2).fill(4,2,"#D9EAF0").wrap(4,2,true);
s.col_width(3,22.0).set(4,3,"Amount").bold(4,3).fill(4,3,"#D9EAF0").wrap(4,3,true);
s.row_height(4,30.0);
s.row_height(5,28.0);
s.set(5,1,"Assets").wrap(5,1,true).fill(5,1,"#F0F5F7");
s.set(5,2,"Cash and equivalents").wrap(5,2,true).fill(5,2,"#F0F5F7");
s.set(5,3,77000).wrap(5,3,true).fill(5,3,"#F0F5F7");
s.number_format(5,3,"$#,##0;[Red]($#,##0)");
s.row_height(6,28.0);
s.set(6,1,"Assets").wrap(6,1,true).fill(6,1,"#FFFFFF");
s.set(6,2,"Accounts receivable").wrap(6,2,true).fill(6,2,"#FFFFFF");
s.set(6,3,112000).wrap(6,3,true).fill(6,3,"#FFFFFF");
s.number_format(6,3,"$#,##0;[Red]($#,##0)");
s.row_height(7,28.0);
s.set(7,1,"Assets").wrap(7,1,true).fill(7,1,"#F0F5F7");
s.set(7,2,"Equipment, net").wrap(7,2,true).fill(7,2,"#F0F5F7");
s.set(7,3,161000).wrap(7,3,true).fill(7,3,"#F0F5F7");
s.number_format(7,3,"$#,##0;[Red]($#,##0)");
s.row_height(8,28.0);
s.set(8,1,"Assets").wrap(8,1,true).fill(8,1,"#FFFFFF");
s.set(8,2,"Total assets").wrap(8,2,true).fill(8,2,"#FFFFFF");
s.formula(8,3,"SUM(C5:C7)").wrap(8,3,true).fill(8,3,"#FFFFFF");
s.number_format(8,3,"$#,##0;[Red]($#,##0)");
s.row_height(9,28.0);
s.set(9,1,"Liabilities").wrap(9,1,true).fill(9,1,"#F0F5F7");
s.set(9,2,"Accounts payable").wrap(9,2,true).fill(9,2,"#F0F5F7");
s.set(9,3,64000).wrap(9,3,true).fill(9,3,"#F0F5F7");
s.number_format(9,3,"$#,##0;[Red]($#,##0)");
s.row_height(10,28.0);
s.set(10,1,"Liabilities").wrap(10,1,true).fill(10,1,"#FFFFFF");
s.set(10,2,"Term loan").wrap(10,2,true).fill(10,2,"#FFFFFF");
s.set(10,3,116000).wrap(10,3,true).fill(10,3,"#FFFFFF");
s.number_format(10,3,"$#,##0;[Red]($#,##0)");
s.row_height(11,28.0);
s.set(11,1,"Equity").wrap(11,1,true).fill(11,1,"#F0F5F7");
s.set(11,2,"Contributed capital").wrap(11,2,true).fill(11,2,"#F0F5F7");
s.set(11,3,120000).wrap(11,3,true).fill(11,3,"#F0F5F7");
s.number_format(11,3,"$#,##0;[Red]($#,##0)");
s.row_height(12,28.0);
s.set(12,1,"Equity").wrap(12,1,true).fill(12,1,"#FFFFFF");
s.set(12,2,"Retained earnings").wrap(12,2,true).fill(12,2,"#FFFFFF");
s.set(12,3,50000).wrap(12,3,true).fill(12,3,"#FFFFFF");
s.number_format(12,3,"$#,##0;[Red]($#,##0)");
s.row_height(13,28.0);
s.set(13,1,"Control").wrap(13,1,true).fill(13,1,"#F0F5F7");
s.set(13,2,"Liabilities and equity").wrap(13,2,true).fill(13,2,"#F0F5F7");
s.formula(13,3,"SUM(C9:C12)").wrap(13,3,true).fill(13,3,"#F0F5F7");
s.number_format(13,3,"$#,##0;[Red]($#,##0)");
s.row_height(14,28.0);
s.set(14,1,"Control").wrap(14,1,true).fill(14,1,"#FFFFFF");
s.set(14,2,"Balance check").wrap(14,2,true).fill(14,2,"#FFFFFF");
s.formula(14,3,"C8-C13").wrap(14,3,true).fill(14,3,"#FFFFFF");
s.number_format(14,3,"$#,##0;[Red]($#,##0)");
s.border_box(4,1,14,3,"thin","#BCCDD5").freeze(4,0).fit_to_page(1,1).page_orientation("landscape");

book.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--lmcode", output + ".dslb"]), 120000); assert(r.code == 0);
