# Pre- and post-round capitalization with ownership formulas All names and figures are fictional.
output = ARGV.len() > 0 ? ARGV[0] : "finance-cap-table.xlsx";
image = output + ".png";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let s = book.sheet("Ownership");
s.merge(1,1,1,5).set(1,1,"Ownership / illustrative seed round").bold(1,1).font_size(1,1,18.0).font_color(1,1,"#FFFFFF").fill(1,1,"#173D55").row_height(1,34.0);
s.merge(2,1,2,5).set(2,1,"Cedar Harbor Group | Planning edition | October 2026").font_color(2,1,"#526675").row_height(2,25.0);
s.col_width(1,28.0).set(4,1,"Holder").bold(4,1).fill(4,1,"#D9EAF0").wrap(4,1,true);
s.col_width(2,22.0).set(4,2,"Common shares").bold(4,2).fill(4,2,"#D9EAF0").wrap(4,2,true);
s.col_width(3,20.0).set(4,3,"New shares").bold(4,3).fill(4,3,"#D9EAF0").wrap(4,3,true);
s.col_width(4,20.0).set(4,4,"Post-round").bold(4,4).fill(4,4,"#D9EAF0").wrap(4,4,true);
s.col_width(5,20.0).set(4,5,"Ownership").bold(4,5).fill(4,5,"#D9EAF0").wrap(4,5,true);
s.row_height(4,30.0);
s.row_height(5,28.0);
s.set(5,1,"Avery Chen").wrap(5,1,true).fill(5,1,"#F0F5F7");
s.set(5,2,400000).wrap(5,2,true).fill(5,2,"#F0F5F7");
s.set(5,3,0).wrap(5,3,true).fill(5,3,"#F0F5F7");
s.formula(5,4,"B5+C5").wrap(5,4,true).fill(5,4,"#F0F5F7");
s.formula(5,5,"D5/SUM(D5:D9)").wrap(5,5,true).fill(5,5,"#F0F5F7");
s.number_format(5,5,"0.0%");
s.row_height(6,28.0);
s.set(6,1,"Morgan Vale").wrap(6,1,true).fill(6,1,"#FFFFFF");
s.set(6,2,300000).wrap(6,2,true).fill(6,2,"#FFFFFF");
s.set(6,3,0).wrap(6,3,true).fill(6,3,"#FFFFFF");
s.formula(6,4,"B6+C6").wrap(6,4,true).fill(6,4,"#FFFFFF");
s.formula(6,5,"D6/SUM(D5:D9)").wrap(6,5,true).fill(6,5,"#FFFFFF");
s.number_format(6,5,"0.0%");
s.row_height(7,28.0);
s.set(7,1,"Employee pool").wrap(7,1,true).fill(7,1,"#F0F5F7");
s.set(7,2,150000).wrap(7,2,true).fill(7,2,"#F0F5F7");
s.set(7,3,50000).wrap(7,3,true).fill(7,3,"#F0F5F7");
s.formula(7,4,"B7+C7").wrap(7,4,true).fill(7,4,"#F0F5F7");
s.formula(7,5,"D7/SUM(D5:D9)").wrap(7,5,true).fill(7,5,"#F0F5F7");
s.number_format(7,5,"0.0%");
s.row_height(8,28.0);
s.set(8,1,"Cedar Seed Fund").wrap(8,1,true).fill(8,1,"#FFFFFF");
s.set(8,2,0).wrap(8,2,true).fill(8,2,"#FFFFFF");
s.set(8,3,250000).wrap(8,3,true).fill(8,3,"#FFFFFF");
s.formula(8,4,"B8+C8").wrap(8,4,true).fill(8,4,"#FFFFFF");
s.formula(8,5,"D8/SUM(D5:D9)").wrap(8,5,true).fill(8,5,"#FFFFFF");
s.number_format(8,5,"0.0%");
s.row_height(9,28.0);
s.set(9,1,"Harbor Angels").wrap(9,1,true).fill(9,1,"#F0F5F7");
s.set(9,2,150000).wrap(9,2,true).fill(9,2,"#F0F5F7");
s.set(9,3,100000).wrap(9,3,true).fill(9,3,"#F0F5F7");
s.formula(9,4,"B9+C9").wrap(9,4,true).fill(9,4,"#F0F5F7");
s.formula(9,5,"D9/SUM(D5:D9)").wrap(9,5,true).fill(9,5,"#F0F5F7");
s.number_format(9,5,"0.0%");
s.border_box(4,1,9,5,"thin","#BCCDD5").freeze(4,0).fit_to_page(1,1).page_orientation("landscape");

book.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--dsl", output + ".dslb"]), 120000); assert(r.code == 0);
