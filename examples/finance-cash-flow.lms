# Rolling cash balances with six months of receipt and payment assumptions All names and figures are fictional.
output = ARGV.len() > 0 ? ARGV[0] : "finance-cash-flow.xlsx";
image = output + ".png";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let s = book.sheet("Cash Flow");
s.merge(1,1,1,5).set(1,1,"Six-month cash-flow forecast").bold(1,1).font_size(1,1,18.0).font_color(1,1,"#FFFFFF").fill(1,1,"#173D55").row_height(1,34.0);
s.merge(2,1,2,5).set(2,1,"Cedar Harbor Group | Planning edition | October 2026").font_color(2,1,"#526675").row_height(2,25.0);
s.col_width(1,24.0).set(4,1,"Month").bold(4,1).fill(4,1,"#D9EAF0").wrap(4,1,true);
s.col_width(2,20.0).set(4,2,"Opening cash").bold(4,2).fill(4,2,"#D9EAF0").wrap(4,2,true);
s.col_width(3,20.0).set(4,3,"Receipts").bold(4,3).fill(4,3,"#D9EAF0").wrap(4,3,true);
s.col_width(4,20.0).set(4,4,"Payments").bold(4,4).fill(4,4,"#D9EAF0").wrap(4,4,true);
s.col_width(5,20.0).set(4,5,"Closing cash").bold(4,5).fill(4,5,"#D9EAF0").wrap(4,5,true);
s.row_height(4,30.0);
s.row_height(5,28.0);
s.set(5,1,"November").wrap(5,1,true).fill(5,1,"#F0F5F7");
s.set(5,2,72000).wrap(5,2,true).fill(5,2,"#F0F5F7");
s.number_format(5,2,"$#,##0;[Red]($#,##0)");
s.set(5,3,95000).wrap(5,3,true).fill(5,3,"#F0F5F7");
s.number_format(5,3,"$#,##0;[Red]($#,##0)");
s.set(5,4,88000).wrap(5,4,true).fill(5,4,"#F0F5F7");
s.number_format(5,4,"$#,##0;[Red]($#,##0)");
s.formula(5,5,"B5+C5-D5").wrap(5,5,true).fill(5,5,"#F0F5F7");
s.number_format(5,5,"$#,##0;[Red]($#,##0)");
s.row_height(6,28.0);
s.set(6,1,"December").wrap(6,1,true).fill(6,1,"#FFFFFF");
s.formula(6,2,"E5").wrap(6,2,true).fill(6,2,"#FFFFFF");
s.number_format(6,2,"$#,##0;[Red]($#,##0)");
s.set(6,3,102000).wrap(6,3,true).fill(6,3,"#FFFFFF");
s.number_format(6,3,"$#,##0;[Red]($#,##0)");
s.set(6,4,97000).wrap(6,4,true).fill(6,4,"#FFFFFF");
s.number_format(6,4,"$#,##0;[Red]($#,##0)");
s.formula(6,5,"B6+C6-D6").wrap(6,5,true).fill(6,5,"#FFFFFF");
s.number_format(6,5,"$#,##0;[Red]($#,##0)");
s.row_height(7,28.0);
s.set(7,1,"January").wrap(7,1,true).fill(7,1,"#F0F5F7");
s.formula(7,2,"E6").wrap(7,2,true).fill(7,2,"#F0F5F7");
s.number_format(7,2,"$#,##0;[Red]($#,##0)");
s.set(7,3,84000).wrap(7,3,true).fill(7,3,"#F0F5F7");
s.number_format(7,3,"$#,##0;[Red]($#,##0)");
s.set(7,4,92000).wrap(7,4,true).fill(7,4,"#F0F5F7");
s.number_format(7,4,"$#,##0;[Red]($#,##0)");
s.formula(7,5,"B7+C7-D7").wrap(7,5,true).fill(7,5,"#F0F5F7");
s.number_format(7,5,"$#,##0;[Red]($#,##0)");
s.row_height(8,28.0);
s.set(8,1,"February").wrap(8,1,true).fill(8,1,"#FFFFFF");
s.formula(8,2,"E7").wrap(8,2,true).fill(8,2,"#FFFFFF");
s.number_format(8,2,"$#,##0;[Red]($#,##0)");
s.set(8,3,108000).wrap(8,3,true).fill(8,3,"#FFFFFF");
s.number_format(8,3,"$#,##0;[Red]($#,##0)");
s.set(8,4,99000).wrap(8,4,true).fill(8,4,"#FFFFFF");
s.number_format(8,4,"$#,##0;[Red]($#,##0)");
s.formula(8,5,"B8+C8-D8").wrap(8,5,true).fill(8,5,"#FFFFFF");
s.number_format(8,5,"$#,##0;[Red]($#,##0)");
s.row_height(9,28.0);
s.set(9,1,"March").wrap(9,1,true).fill(9,1,"#F0F5F7");
s.formula(9,2,"E8").wrap(9,2,true).fill(9,2,"#F0F5F7");
s.number_format(9,2,"$#,##0;[Red]($#,##0)");
s.set(9,3,114000).wrap(9,3,true).fill(9,3,"#F0F5F7");
s.number_format(9,3,"$#,##0;[Red]($#,##0)");
s.set(9,4,103000).wrap(9,4,true).fill(9,4,"#F0F5F7");
s.number_format(9,4,"$#,##0;[Red]($#,##0)");
s.formula(9,5,"B9+C9-D9").wrap(9,5,true).fill(9,5,"#F0F5F7");
s.number_format(9,5,"$#,##0;[Red]($#,##0)");
s.row_height(10,28.0);
s.set(10,1,"April").wrap(10,1,true).fill(10,1,"#FFFFFF");
s.formula(10,2,"E9").wrap(10,2,true).fill(10,2,"#FFFFFF");
s.number_format(10,2,"$#,##0;[Red]($#,##0)");
s.set(10,3,120000).wrap(10,3,true).fill(10,3,"#FFFFFF");
s.number_format(10,3,"$#,##0;[Red]($#,##0)");
s.set(10,4,109000).wrap(10,4,true).fill(10,4,"#FFFFFF");
s.number_format(10,4,"$#,##0;[Red]($#,##0)");
s.formula(10,5,"B10+C10-D10").wrap(10,5,true).fill(10,5,"#FFFFFF");
s.number_format(10,5,"$#,##0;[Red]($#,##0)");
s.border_box(4,1,10,5,"thin","#BCCDD5").freeze(4,0).fit_to_page(1,1).page_orientation("landscape");
s.conditional_icon_set(5,5,10,5,"3Arrows");
book.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--dsl", output + ".dslb"]), 120000); assert(r.code == 0);
