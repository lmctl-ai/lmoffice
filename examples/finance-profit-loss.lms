# Quarterly P&L with formulas, native chart and an embedded image All names and figures are fictional.
output = ARGV.len() > 0 ? ARGV[0] : "finance-profit-loss.xlsx";
image = output + ".png";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let s = book.sheet("P and L");
s.merge(1,1,1,5).set(1,1,"Quarterly profit and loss").bold(1,1).font_size(1,1,18.0).font_color(1,1,"#FFFFFF").fill(1,1,"#173D55").row_height(1,34.0);
s.merge(2,1,2,5).set(2,1,"Cedar Harbor Group | Planning edition | October 2026").font_color(2,1,"#526675").row_height(2,25.0);
s.col_width(1,24.0).set(4,1,"Month").bold(4,1).fill(4,1,"#D9EAF0").wrap(4,1,true);
s.col_width(2,18.0).set(4,2,"Revenue").bold(4,2).fill(4,2,"#D9EAF0").wrap(4,2,true);
s.col_width(3,18.0).set(4,3,"Direct costs").bold(4,3).fill(4,3,"#D9EAF0").wrap(4,3,true);
s.col_width(4,18.0).set(4,4,"Overhead").bold(4,4).fill(4,4,"#D9EAF0").wrap(4,4,true);
s.col_width(5,18.0).set(4,5,"Net profit").bold(4,5).fill(4,5,"#D9EAF0").wrap(4,5,true);
s.row_height(4,30.0);
s.row_height(5,28.0);
s.set(5,1,"July").wrap(5,1,true).fill(5,1,"#F0F5F7");
s.set(5,2,85000).wrap(5,2,true).fill(5,2,"#F0F5F7");
s.number_format(5,2,"$#,##0;[Red]($#,##0)");
s.set(5,3,36000).wrap(5,3,true).fill(5,3,"#F0F5F7");
s.number_format(5,3,"$#,##0;[Red]($#,##0)");
s.set(5,4,16000).wrap(5,4,true).fill(5,4,"#F0F5F7");
s.number_format(5,4,"$#,##0;[Red]($#,##0)");
s.formula(5,5,"B5-C5-D5").wrap(5,5,true).fill(5,5,"#F0F5F7");
s.number_format(5,5,"$#,##0;[Red]($#,##0)");
s.row_height(6,28.0);
s.set(6,1,"August").wrap(6,1,true).fill(6,1,"#FFFFFF");
s.set(6,2,91000).wrap(6,2,true).fill(6,2,"#FFFFFF");
s.number_format(6,2,"$#,##0;[Red]($#,##0)");
s.set(6,3,39000).wrap(6,3,true).fill(6,3,"#FFFFFF");
s.number_format(6,3,"$#,##0;[Red]($#,##0)");
s.set(6,4,17000).wrap(6,4,true).fill(6,4,"#FFFFFF");
s.number_format(6,4,"$#,##0;[Red]($#,##0)");
s.formula(6,5,"B6-C6-D6").wrap(6,5,true).fill(6,5,"#FFFFFF");
s.number_format(6,5,"$#,##0;[Red]($#,##0)");
s.row_height(7,28.0);
s.set(7,1,"September").wrap(7,1,true).fill(7,1,"#F0F5F7");
s.set(7,2,98000).wrap(7,2,true).fill(7,2,"#F0F5F7");
s.number_format(7,2,"$#,##0;[Red]($#,##0)");
s.set(7,3,41000).wrap(7,3,true).fill(7,3,"#F0F5F7");
s.number_format(7,3,"$#,##0;[Red]($#,##0)");
s.set(7,4,18000).wrap(7,4,true).fill(7,4,"#F0F5F7");
s.number_format(7,4,"$#,##0;[Red]($#,##0)");
s.formula(7,5,"B7-C7-D7").wrap(7,5,true).fill(7,5,"#F0F5F7");
s.number_format(7,5,"$#,##0;[Red]($#,##0)");
s.row_height(8,28.0);
s.set(8,1,"Quarter total").wrap(8,1,true).fill(8,1,"#FFFFFF");
s.formula(8,2,"SUM(B5:B7)").wrap(8,2,true).fill(8,2,"#FFFFFF");
s.number_format(8,2,"$#,##0;[Red]($#,##0)");
s.formula(8,3,"SUM(C5:C7)").wrap(8,3,true).fill(8,3,"#FFFFFF");
s.number_format(8,3,"$#,##0;[Red]($#,##0)");
s.formula(8,4,"SUM(D5:D7)").wrap(8,4,true).fill(8,4,"#FFFFFF");
s.number_format(8,4,"$#,##0;[Red]($#,##0)");
s.formula(8,5,"SUM(E5:E7)").wrap(8,5,true).fill(8,5,"#FFFFFF");
s.number_format(8,5,"$#,##0;[Red]($#,##0)");
s.border_box(4,1,8,5,"thin","#BCCDD5").freeze(4,0).fit_to_page(1,1).page_orientation("landscape");
xlsx.sample_image(${image}); book.image(${image},2,7,140,100); s.set(8,7,"Embedded brand image").col_width(7,25.0); s.bar_chart(11,1,26,6,"Monthly revenue","A5:A7","B5:B7");
book.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--dsl", output + ".dslb"]), 120000); assert(r.code == 0);
