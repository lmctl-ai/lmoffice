# Illustrative deduction worksheet with evidence and fictional allowance assumptions All names and figures are fictional.
output = ARGV.len() > 0 ? ARGV[0] : "finance-tax-worksheet.xlsx";
image = output + ".png";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let s = book.sheet("Planning");
s.merge(1,1,1,5).set(1,1,"Tax-style planning worksheet").bold(1,1).font_size(1,1,18.0).font_color(1,1,"#FFFFFF").fill(1,1,"#173D55").row_height(1,34.0);
s.merge(2,1,2,5).set(2,1,"Cedar Harbor Group | Planning edition | October 2026").font_color(2,1,"#526675").row_height(2,25.0);
s.col_width(1,26.0).set(4,1,"Category").bold(4,1).fill(4,1,"#D9EAF0").wrap(4,1,true);
s.col_width(2,22.0).set(4,2,"Gross amount").bold(4,2).fill(4,2,"#D9EAF0").wrap(4,2,true);
s.col_width(3,18.0).set(4,3,"Allowable %").bold(4,3).fill(4,3,"#D9EAF0").wrap(4,3,true);
s.col_width(4,22.0).set(4,4,"Allowed amount").bold(4,4).fill(4,4,"#D9EAF0").wrap(4,4,true);
s.col_width(5,40.0).set(4,5,"Evidence").bold(4,5).fill(4,5,"#D9EAF0").wrap(4,5,true);
s.row_height(4,30.0);
s.row_height(5,28.0);
s.set(5,1,"Service income").wrap(5,1,true).fill(5,1,"#F0F5F7");
s.set(5,2,240000).wrap(5,2,true).fill(5,2,"#F0F5F7");
s.number_format(5,2,"$#,##0;[Red]($#,##0)");
s.set(5,3,1.0).wrap(5,3,true).fill(5,3,"#F0F5F7");
s.number_format(5,3,"0.0%");
s.formula(5,4,"B5*C5").wrap(5,4,true).fill(5,4,"#F0F5F7");
s.number_format(5,4,"$#,##0;[Red]($#,##0)");
s.set(5,5,"Invoice register").wrap(5,5,true).fill(5,5,"#F0F5F7");
s.row_height(6,28.0);
s.set(6,1,"Materials").wrap(6,1,true).fill(6,1,"#FFFFFF");
s.set(6,2,38000).wrap(6,2,true).fill(6,2,"#FFFFFF");
s.number_format(6,2,"$#,##0;[Red]($#,##0)");
s.set(6,3,1.0).wrap(6,3,true).fill(6,3,"#FFFFFF");
s.number_format(6,3,"0.0%");
s.formula(6,4,"B6*C6").wrap(6,4,true).fill(6,4,"#FFFFFF");
s.number_format(6,4,"$#,##0;[Red]($#,##0)");
s.set(6,5,"Supplier ledger").wrap(6,5,true).fill(6,5,"#FFFFFF");
s.row_height(7,28.0);
s.set(7,1,"Office rent").wrap(7,1,true).fill(7,1,"#F0F5F7");
s.set(7,2,24000).wrap(7,2,true).fill(7,2,"#F0F5F7");
s.number_format(7,2,"$#,##0;[Red]($#,##0)");
s.set(7,3,1.0).wrap(7,3,true).fill(7,3,"#F0F5F7");
s.number_format(7,3,"0.0%");
s.formula(7,4,"B7*C7").wrap(7,4,true).fill(7,4,"#F0F5F7");
s.number_format(7,4,"$#,##0;[Red]($#,##0)");
s.set(7,5,"Lease schedule").wrap(7,5,true).fill(7,5,"#F0F5F7");
s.row_height(8,28.0);
s.set(8,1,"Travel").wrap(8,1,true).fill(8,1,"#FFFFFF");
s.set(8,2,6800).wrap(8,2,true).fill(8,2,"#FFFFFF");
s.number_format(8,2,"$#,##0;[Red]($#,##0)");
s.set(8,3,0.8).wrap(8,3,true).fill(8,3,"#FFFFFF");
s.number_format(8,3,"0.0%");
s.formula(8,4,"B8*C8").wrap(8,4,true).fill(8,4,"#FFFFFF");
s.number_format(8,4,"$#,##0;[Red]($#,##0)");
s.set(8,5,"Travel log").wrap(8,5,true).fill(8,5,"#FFFFFF");
s.row_height(9,28.0);
s.set(9,1,"Equipment").wrap(9,1,true).fill(9,1,"#F0F5F7");
s.set(9,2,12000).wrap(9,2,true).fill(9,2,"#F0F5F7");
s.number_format(9,2,"$#,##0;[Red]($#,##0)");
s.set(9,3,0.25).wrap(9,3,true).fill(9,3,"#F0F5F7");
s.number_format(9,3,"0.0%");
s.formula(9,4,"B9*C9").wrap(9,4,true).fill(9,4,"#F0F5F7");
s.number_format(9,4,"$#,##0;[Red]($#,##0)");
s.set(9,5,"Asset register").wrap(9,5,true).fill(9,5,"#F0F5F7");
s.row_height(10,28.0);
s.set(10,1,"Illustrative net").wrap(10,1,true).fill(10,1,"#FFFFFF");
s.formula(10,2,"D5-SUM(D6:D9)").wrap(10,2,true).fill(10,2,"#FFFFFF");
s.number_format(10,2,"$#,##0;[Red]($#,##0)");
s.set(10,3,1.0).wrap(10,3,true).fill(10,3,"#FFFFFF");
s.number_format(10,3,"0.0%");
s.formula(10,4,"B10*C10").wrap(10,4,true).fill(10,4,"#FFFFFF");
s.number_format(10,4,"$#,##0;[Red]($#,##0)");
s.set(10,5,"Planning only; fictional assumptions").wrap(10,5,true).fill(10,5,"#FFFFFF");
s.border_box(4,1,10,5,"thin","#BCCDD5").freeze(4,0).fit_to_page(1,1).page_orientation("landscape");

book.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--dsl", output + ".dslb"]), 120000); assert(r.code == 0);
