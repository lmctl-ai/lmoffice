# Academic course gradebook with weighted scoring, statistics, and conditional formatting.
output = ARGV.len() > 0 ? ARGV[0] : "gradebook.xlsx";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let s = book.sheet("CS101 Gradebook");
s.tab_color("#70AD47");
s.page_orientation("landscape");
s.freeze(4, 2);

# Course Header
s.set(1, 1, "CS 101: INTRO TO COMPUTER SYSTEMS - FALL 2026");
s.bold(1, 1);
s.font_size(1, 1, 14.0);
s.font_color(1, 1, "#385723");

# Grading Weights
s.set(2, 1, "Grading Weights:").set(2, 3, "HW (20%)").set(2, 4, "Midterm (30%)").set(2, 5, "Final (40%)").set(2, 6, "Participation (10%)");
s.bold(2, 1);

# Table Header
s.set(4, 1, "Student ID").set(4, 2, "Student Name").set(4, 3, "Homework").set(4, 4, "Midterm").set(4, 5, "Final Exam").set(4, 6, "Participation").set(4, 7, "Weighted Score").set(4, 8, "Status");
s.bold(4, 1).bold(4, 2).bold(4, 3).bold(4, 4).bold(4, 5).bold(4, 6).bold(4, 7).bold(4, 8);
s.fill(4, 1, "#385723").fill(4, 2, "#385723").fill(4, 3, "#385723").fill(4, 4, "#385723").fill(4, 5, "#385723").fill(4, 6, "#385723").fill(4, 7, "#385723").fill(4, 8, "#385723");
s.font_color(4, 1, "#FFFFFF").font_color(4, 2, "#FFFFFF").font_color(4, 3, "#FFFFFF").font_color(4, 4, "#FFFFFF").font_color(4, 5, "#FFFFFF").font_color(4, 6, "#FFFFFF").font_color(4, 7, "#FFFFFF").font_color(4, 8, "#FFFFFF");

# Students
s.set(5, 1, "STU-101").set(5, 2, "Avery Chen").set(5, 3, 94.0).set(5, 4, 88.0).set(5, 5, 92.0).set(5, 6, 95.0).formula(5, 7, "C5*0.2+D5*0.3+E5*0.4+F5*0.1").set(5, 8, "Pass");
s.set(6, 1, "STU-102").set(6, 2, "Brooke Taylor").set(6, 3, 82.0).set(6, 4, 79.0).set(6, 5, 85.0).set(6, 6, 90.0).formula(6, 7, "C6*0.2+D6*0.3+E6*0.4+F6*0.1").set(6, 8, "Pass");
s.set(7, 1, "STU-103").set(7, 2, "Carter Miller").set(7, 3, 70.0).set(7, 4, 65.0).set(7, 5, 68.0).set(7, 6, 80.0).formula(7, 7, "C7*0.2+D7*0.3+E7*0.4+F7*0.1").set(7, 8, "Pass");
s.set(8, 1, "STU-104").set(8, 2, "Devon Rossi").set(8, 3, 98.0).set(8, 4, 95.0).set(8, 5, 96.0).set(8, 6, 100.0).formula(8, 7, "C8*0.2+D8*0.3+E8*0.4+F8*0.1").set(8, 8, "Pass");
s.set(9, 1, "STU-105").set(9, 2, "Elena Gomez").set(9, 3, 88.0).set(9, 4, 91.0).set(9, 5, 89.0).set(9, 6, 95.0).formula(9, 7, "C9*0.2+D9*0.3+E9*0.4+F9*0.1").set(9, 8, "Pass");
s.set(10, 1, "STU-106").set(10, 2, "Farhan Malik").set(10, 3, 58.0).set(10, 4, 62.0).set(10, 5, 54.0).set(10, 6, 70.0).formula(10, 7, "C10*0.2+D10*0.3+E10*0.4+F10*0.1").set(10, 8, "Review");

# Summary Stats
s.set(12, 2, "Class Average").formula(12, 3, "AVERAGE(C5:C10)").formula(12, 4, "AVERAGE(D5:D10)").formula(12, 5, "AVERAGE(E5:E10)").formula(12, 6, "AVERAGE(F5:F10)").formula(12, 7, "AVERAGE(G5:G10)");
s.set(13, 2, "Highest Score").formula(13, 3, "MAX(C5:C10)").formula(13, 4, "MAX(D5:D10)").formula(13, 5, "MAX(E5:E10)").formula(13, 6, "MAX(F5:F10)").formula(13, 7, "MAX(G5:G10)");
s.set(14, 2, "Lowest Score").formula(14, 3, "MIN(C5:C10)").formula(14, 4, "MIN(D5:D10)").formula(14, 5, "MIN(E5:E10)").formula(14, 6, "MIN(F5:F10)").formula(14, 7, "MIN(G5:G10)");

s.bold(12, 2).bold(13, 2).bold(14, 2);
s.fill(12, 2, "#E2EFDA").fill(12, 3, "#E2EFDA").fill(12, 4, "#E2EFDA").fill(12, 5, "#E2EFDA").fill(12, 6, "#E2EFDA").fill(12, 7, "#E2EFDA");

# Format numbers & widths
s.number_format(5, 7, "0.0").number_format(6, 7, "0.0").number_format(7, 7, "0.0").number_format(8, 7, "0.0").number_format(9, 7, "0.0").number_format(10, 7, "0.0");
s.number_format(12, 3, "0.0").number_format(12, 4, "0.0").number_format(12, 5, "0.0").number_format(12, 6, "0.0").number_format(12, 7, "0.0");

s.border_box(4, 1, 10, 8, "thin", "#BFBFBF");
s.border_box(12, 2, 14, 7, "thin", "#70AD47");
s.col_width(1, 14.0).col_width(2, 20.0).col_width(3, 14.0).col_width(4, 14.0).col_width(5, 14.0).col_width(6, 15.0).col_width(7, 16.0).col_width(8, 12.0);

# Conditional Formatting
s.conditional_color_scale(5, 7, 10, 7, "#F8696B", "#63BE7B");
s.conditional_cell_is(5, 8, 10, 8, "=", "Review", "#FFC7CE", "#9C0006");

s.autofilter(4, 1, 10, 8);

book.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--dsl", output + ".dslb"]), 120000);
assert(r.code == 0);
