s.formula(8,5,"B8-C8-D8").wrap(8,5,true).fill(8,5,"#FFFFFF");
s.set(8,6,"Dec 21–24").wrap(8,6,true).fill(8,6,"#FFFFFF");
s.row_height(9,28.0);
s.set(9,1,"Sam Ortega").wrap(9,1,true).fill(9,1,"#F0F5F7");
s.set(9,2,25).wrap(9,2,true).fill(9,2,"#F0F5F7");
s.set(9,3,19).wrap(9,3,true).fill(9,3,"#F0F5F7");
