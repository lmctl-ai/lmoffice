# Leave allowance, bookings and remaining-balance formulas All names and figures are fictional.
output = ARGV.len() > 0 ? ARGV[0] : "hr-leave-tracker.xlsx";
image = output + ".png";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let s = book.sheet("Leave");
s.merge(1,1,1,6).set(1,1,"People operations / leave balances").bold(1,1).font_size(1,1,18.0).font_color(1,1,"#FFFFFF").fill(1,1,"#173D55").row_height(1,34.0);
s.merge(2,1,2,6).set(2,1,"Cedar Harbor Group | Planning edition | October 2026").font_color(2,1,"#526675").row_height(2,25.0);
s.col_width(1,25.0).set(4,1,"Team member").bold(4,1).fill(4,1,"#D9EAF0").wrap(4,1,true);
s.col_width(2,16.0).set(4,2,"Allowance").bold(4,2).fill(4,2,"#D9EAF0").wrap(4,2,true);
s.col_width(3,14.0).set(4,3,"Taken").bold(4,3).fill(4,3,"#D9EAF0").wrap(4,3,true);
s.col_width(4,14.0).set(4,4,"Booked").bold(4,4).fill(4,4,"#D9EAF0").wrap(4,4,true);
s.col_width(5,18.0).set(4,5,"Remaining").bold(4,5).fill(4,5,"#D9EAF0").wrap(4,5,true);
s.col_width(6,24.0).set(4,6,"Next leave").bold(4,6).fill(4,6,"#D9EAF0").wrap(4,6,true);
s.row_height(4,30.0);
s.row_height(5,28.0);
s.set(5,1,"Avery Chen").wrap(5,1,true).fill(5,1,"#F0F5F7");
s.set(5,2,25).wrap(5,2,true).fill(5,2,"#F0F5F7");
s.set(5,3,12).wrap(5,3,true).fill(5,3,"#F0F5F7");
s.set(5,4,3).wrap(5,4,true).fill(5,4,"#F0F5F7");
s.formula(5,5,"B5-C5-D5").wrap(5,5,true).fill(5,5,"#F0F5F7");
s.set(5,6,"Nov 02–04").wrap(5,6,true).fill(5,6,"#F0F5F7");
s.row_height(6,28.0);
s.set(6,1,"Morgan Vale").wrap(6,1,true).fill(6,1,"#FFFFFF");
s.set(6,2,25).wrap(6,2,true).fill(6,2,"#FFFFFF");
s.set(6,3,9).wrap(6,3,true).fill(6,3,"#FFFFFF");
