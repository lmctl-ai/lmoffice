s.formula(6,5,"B6-C6-D6").wrap(6,5,true).fill(6,5,"#FFFFFF");
s.set(6,6,"Dec 07–11").wrap(6,6,true).fill(6,6,"#FFFFFF");
s.row_height(7,28.0);
s.set(7,1,"Jules Park").wrap(7,1,true).fill(7,1,"#F0F5F7");
s.set(7,2,25).wrap(7,2,true).fill(7,2,"#F0F5F7");
s.set(7,3,17).wrap(7,3,true).fill(7,3,"#F0F5F7");
s.set(7,4,2).wrap(7,4,true).fill(7,4,"#F0F5F7");
s.formula(7,5,"B7-C7-D7").wrap(7,5,true).fill(7,5,"#F0F5F7");
s.set(7,6,"Nov 12–13").wrap(7,6,true).fill(7,6,"#F0F5F7");
s.row_height(8,28.0);
s.set(8,1,"Riley Ford").wrap(8,1,true).fill(8,1,"#FFFFFF");
s.set(8,2,25).wrap(8,2,true).fill(8,2,"#FFFFFF");
