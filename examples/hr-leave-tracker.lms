s.formula(10,5,"B10-C10-D10").wrap(10,5,true).fill(10,5,"#FFFFFF");
s.set(10,6,"Nov 23–25").wrap(10,6,true).fill(10,6,"#FFFFFF");
s.border_box(4,1,10,6,"thin","#BCCDD5").freeze(4,0).fit_to_page(1,1).page_orientation("landscape");
s.conditional_icon_set(5,5,10,5,"3Flags");
book.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--dsl", output + ".dslb"]), 120000); assert(r.code == 0);
