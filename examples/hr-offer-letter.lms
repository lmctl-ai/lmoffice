# Fictional employment offer.
output = ARGV.len() > 0 ? ARGV[0] : "hr-offer-letter.docx";
p=_lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
let d=docx.create(${output}); d.title("Offer of Employment").author("Cedar Peak Analytics").font("Aptos").font_size(11.0).margins(54.0,54.0,54.0,54.0); d.paragraph("August 12, 2027").tab_stop(504.0,"right"); d.paragraph("Riley Chen\n28 Grove Street\nMadison, WI 53703"); d.heading("Offer of employment",1).color("#17324D"); d.paragraph("Cedar Peak Analytics is pleased to offer you the position of Senior Operations Analyst reporting to Priya Nandakumar. Your anticipated start date is September 13, 2027."); d.heading("Terms",2); let t=d.table(6,2); t.cell(1,1,"Base salary").cell(1,2,"$112,000 annually").cell(2,1,"Bonus").cell(2,2,"Eligible for annual plan").cell(3,1,"Location").cell(3,2,"Madison hybrid office").cell(4,1,"Benefits").cell(4,2,"Health, retirement, paid leave").cell(5,1,"Manager").cell(5,2,"Priya Nandakumar").cell(6,1,"Response by").cell(6,2,"August 20, 2027").borders(true).shade(1,1,"#D9EAF7"); d.heading("Conditions",2); d.paragraph("This offer is subject to employment verification and authorization to work in the United States. Please sign and return this letter by the response date."); d.signature("Cedar Peak Analytics"); d.signature("Riley Chen"); d.header_fields("Cedar Peak Analytics | {PAGE}/{NUMPAGES}").save();
end _lmcode_
savedsl(p,output+".dslb"); r=system(concat(dsl_cli(p),["--lmcode",output+".dslb"]),120000); assert(r.code==0);
