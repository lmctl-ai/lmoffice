# Fictional new-hire checklist.
output = ARGV.len() > 0 ? ARGV[0] : "hr-onboarding-checklist.docx";
p=_lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
let d=docx.create(${output}); d.title("New Hire Onboarding").author("Cedar Peak Analytics").font("Aptos").font_size(10.5).margins(48.0,48.0,48.0,48.0); d.heading("First 30 days checklist",1).color("#17324D"); d.paragraph("New hire: Riley Chen   Manager: Priya Nandakumar   Start: September 13, 2027"); let t=d.table(6,4); t.cell(1,1,"When").cell(1,2,"Action").cell(1,3,"Owner").cell(1,4,"Done").cell(2,1,"Day 1").cell(2,2,"Welcome, badge, accounts").cell(2,3,"People Ops").cell(2,4,"☐").cell(3,1,"Day 3").cell(3,2,"Meet team and buddy").cell(3,3,"Manager").cell(3,4,"☐").cell(4,1,"Week 1").cell(4,2,"Read operating playbooks").cell(4,3,"New hire").cell(4,4,"☐").cell(5,1,"Week 2").cell(5,2,"Shadow customer review").cell(5,3,"Samira Ortiz").cell(5,4,"☐").cell(6,1,"Day 30").cell(6,2,"Share first improvement idea").cell(6,3,"New hire").cell(6,4,"☐").borders(true).shade(1,1,"#D9EAF7"); d.heading("Success signals",2); d.bullet("Can find the customer escalation path and explain its owner."); d.bullet("Has completed a supervised workflow from intake to resolution."); d.bullet("Has a 60-day goal agreed with the manager."); d.heading("Check-in notes",2); d.paragraph("Week 1: ____________________\nWeek 2: ____________________\nDay 30: ____________________"); d.header_fields("Cedar Peak Analytics | {PAGE}/{NUMPAGES}").save();
end _lmcode_
savedsl(p,output+".dslb"); r=system(concat(dsl_cli(p),["--lmcode",output+".dslb"]),120000); assert(r.code==0);
