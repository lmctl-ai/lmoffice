# Fictional organization chart rendered as a table.
output = ARGV.len() > 0 ? ARGV[0] : "hr-org-chart.docx";
p=_lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
let d=docx.create(${output}); d.title("Cedar Peak Organization").author("Cedar Peak Analytics").font("Aptos").font_size(11.0).margins(54.0,54.0,54.0,54.0); d.heading("Operations organization",1).align("center").color("#17324D"); d.paragraph("Effective September 2027 · Fictional Cedar Peak Analytics").align("center"); let lead=d.table(1,4); lead.cell(1,1,"Executive sponsor: Priya Nandakumar / Chief Operating Officer").merge(1,1,1,4).shade(1,1,"#D9EAF7").cell_border(1,1,"bottom","#185A80",12); d.paragraph(""); let t=d.table(6,4); t.cell(1,1,"Leader").cell(1,2,"Function").cell(1,3,"Direct reports").cell(1,4,"Primary outcome").cell(2,1,"Priya Nandakumar").cell(2,2,"Chief Operating Officer").cell(2,3,"5 directors").cell(2,4,"Reliable customer delivery").cell(3,1,"Samira Ortiz").cell(3,2,"Customer Operations").cell(3,3,"12 specialists").cell(3,4,"Fast resolution").cell(4,1,"Darius Bell").cell(4,2,"Data Products").cell(4,3,"8 analysts").cell(4,4,"Trusted forecasts").cell(5,1,"Linh Tran").cell(5,2,"Enablement").cell(5,3,"6 coaches").cell(5,4,"Confident adoption").cell(6,1,"Mara Ellis").cell(6,2,"People Operations").cell(6,3,"4 partners").cell(6,4,"Healthy teams").borders(true).shade(1,1,"#185A80").shade(1,2,"#185A80").shade(1,3,"#185A80").shade(1,4,"#185A80"); d.heading("Collaboration rhythm",2); d.paragraph("Directors meet Tuesdays for operating decisions; leads meet Thursdays for dependency review. Each function publishes one measurable outcome and one open risk each week."); d.text_box("The chart describes reporting lines, not job seniority.",360.0,42.0); d.header_fields("People Operations | {PAGE}/{NUMPAGES}").save();
end _lmcode_
savedsl(p,output+".dslb"); r=system(concat(dsl_cli(p),["--lmcode",output+".dslb"]),120000); assert(r.code==0);
