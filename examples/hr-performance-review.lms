# Fictional performance review with tracked review notes.
output = ARGV.len() > 0 ? ARGV[0] : "hr-performance-review.docx";
p=_lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
let d=docx.create(${output}); d.title("Performance Review").author("Cedar Peak Analytics").font("Aptos").font_size(10.5).margins(48.0,48.0,48.0,48.0); d.heading("Performance review",1); d.paragraph("Employee: Samira Ortiz   Role: Customer Operations Lead   Review period: Jan–Jun 2027"); d.heading("Summary",2); d.paragraph("Samira improved escalation handoffs and created a useful weekly service review. The next half-year should focus on coaching new leads and documenting repeatable playbooks.").comment("Confirm metrics before final sign-off", "Priya Nandakumar"); let t=d.table(6,3); t.cell(1,1,"Goal").cell(1,2,"Evidence").cell(1,3,"Rating").cell(2,1,"Response time").cell(2,2,"Reduced median from 6h to 2h").cell(2,3,"Exceeds").cell(3,1,"Coaching").cell(3,2,"Two new lead shadowing plans").cell(3,3,"Meets").cell(4,1,"Documentation").cell(4,2,"Published four playbooks").cell(4,3,"Exceeds").cell(5,1,"Quality").cell(5,2,"Audit sample at 97%").cell(5,3,"Meets").cell(6,1,"Next goal").cell(6,2,"Train three new leads").cell(6,3,"2027 H2").borders(true).shade(1,1,"#D9EAF7").shade(1,2,"#D9EAF7").shade(1,3,"#D9EAF7"); d.heading("Development plan",2); d.paragraph("Review cadence: ").deleted("quarterly status meeting", "Priya Nandakumar").inserted("monthly coaching circle and a quarterly playbook audit.","Priya Nandakumar"); d.signature("Employee"); d.signature("Manager"); d.save();
end _lmcode_
savedsl(p,output+".dslb"); r=system(concat(dsl_cli(p),["--dsl",output+".dslb"]),120000); assert(r.code==0);
