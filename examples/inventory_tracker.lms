# Warehouse inventory tracker with reorder alerts, valuations, and conditional formatting.
output = ARGV.len() > 0 ? ARGV[0] : "inventory_tracker.xlsx";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let s = book.sheet("Inventory");
s.tab_color("#70AD47");
s.page_orientation("landscape");
s.fit_to_page(1, 1);
s.freeze(4, 2);

# Title
s.set(1, 1, "CENTRAL WAREHOUSE INVENTORY TRACKER");
s.bold(1, 1);
s.font_size(1, 1, 15.0);
s.font_color(1, 1, "#385723");

# KPIs
s.set(2, 1, "Total Stock Value").set(2, 3, "Total Units in Stock").set(2, 5, "Reorder Alerts");
s.bold(2, 1).bold(2, 3).bold(2, 5);
s.formula(3, 1, "SUM(G5:G11)").formula(3, 3, "SUM(D5:D11)").formula(3, 5, "COUNTIF(H5:H11,\"Reorder\")");
s.bold(3, 1).bold(3, 3).bold(3, 5);
s.number_format(3, 1, "$#,##0.00").number_format(3, 3, "#,##0");
s.fill(2, 1, "#E2EFDA").fill(2, 3, "#D9E1F2").fill(2, 5, "#FCE4D6");
s.fill(3, 1, "#E2EFDA").fill(3, 3, "#D9E1F2").fill(3, 5, "#FCE4D6");

# Table Header
s.set(4, 1, "SKU").set(4, 2, "Item Description").set(4, 3, "Category").set(4, 4, "Qty on Hand").set(4, 5, "Reorder Min").set(4, 6, "Unit Cost").set(4, 7, "Stock Value").set(4, 8, "Alert");
s.bold(4, 1).bold(4, 2).bold(4, 3).bold(4, 4).bold(4, 5).bold(4, 6).bold(4, 7).bold(4, 8);
s.fill(4, 1, "#385723").fill(4, 2, "#385723").fill(4, 3, "#385723").fill(4, 4, "#385723").fill(4, 5, "#385723").fill(4, 6, "#385723").fill(4, 7, "#385723").fill(4, 8, "#385723");
s.font_color(4, 1, "#FFFFFF").font_color(4, 2, "#FFFFFF").font_color(4, 3, "#FFFFFF").font_color(4, 4, "#FFFFFF").font_color(4, 5, "#FFFFFF").font_color(4, 6, "#FFFFFF").font_color(4, 7, "#FFFFFF").font_color(4, 8, "#FFFFFF");

# Inventory Items
s.set(5, 1, "SKU-4001").set(5, 2, "Cat6 Ethernet Cable (1000ft)").set(5, 3, "Networking").set(5, 4, 45).set(5, 5, 20).set(5, 6, 128.50).formula(5, 7, "D5*F5").set(5, 8, "OK");
s.set(6, 1, "SKU-4002").set(6, 2, "24-Port Gigabit PoE Switch").set(6, 3, "Hardware").set(6, 4, 8).set(6, 5, 12).set(6, 6, 385.00).formula(6, 7, "D6*F6").set(6, 8, "Reorder");
s.set(7, 1, "SKU-4003").set(7, 2, "Server Rack PDU (30A)").set(7, 3, "Power").set(7, 4, 14).set(7, 5, 10).set(7, 6, 210.00).formula(7, 7, "D7*F7").set(7, 8, "OK");
s.set(8, 1, "SKU-4004").set(8, 2, "10G SFP+ Optical Transceiver").set(8, 3, "Optics").set(8, 4, 120).set(8, 5, 50).set(8, 6, 42.00).formula(8, 7, "D8*F8").set(8, 8, "OK");
s.set(9, 1, "SKU-4005").set(9, 2, "Dual-Port 25GbE NIC").set(9, 3, "Hardware").set(9, 4, 4).set(9, 5, 15).set(9, 6, 290.00).formula(9, 7, "D9*F9").set(9, 8, "Reorder");
s.set(10, 1, "SKU-4006").set(10, 2, "LC-LC Duplex Fiber Patch (5m)").set(10, 3, "Optics").set(10, 4, 85).set(10, 5, 30).set(10, 6, 14.50).formula(10, 7, "D10*F10").set(10, 8, "OK");
s.set(11, 1, "SKU-4007").set(11, 2, "UPS Battery Pack 1500VA").set(11, 3, "Power").set(11, 4, 3).set(11, 5, 6).set(11, 6, 450.00).formula(11, 7, "D11*F11").set(11, 8, "Reorder");

# Formatting
s.number_format(5, 6, "$#,##0.00").number_format(6, 6, "$#,##0.00").number_format(7, 6, "$#,##0.00").number_format(8, 6, "$#,##0.00").number_format(9, 6, "$#,##0.00").number_format(10, 6, "$#,##0.00").number_format(11, 6, "$#,##0.00");
s.number_format(5, 7, "$#,##0.00").number_format(6, 7, "$#,##0.00").number_format(7, 7, "$#,##0.00").number_format(8, 7, "$#,##0.00").number_format(9, 7, "$#,##0.00").number_format(10, 7, "$#,##0.00").number_format(11, 7, "$#,##0.00");

s.col_width(1, 14.0).col_width(2, 34.0).col_width(3, 16.0).col_width(4, 14.0).col_width(5, 14.0).col_width(6, 14.0).col_width(7, 16.0).col_width(8, 12.0);
s.border_box(4, 1, 11, 8, "thin", "#BFBFBF");

# Conditional formatting for reorder alert
s.conditional_cell_is(5, 8, 11, 8, "=", "Reorder", "#FFC7CE", "#9C0006");

s.autofilter(4, 1, 11, 8);

book.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--lmcode", output + ".dslb"]), 120000);
assert(r.code == 0);
