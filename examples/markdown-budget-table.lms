# Budget workbook authored from one Markdown table.
output = ARGV.len() > 0 ? ARGV[0] : "markdown-budget-table.xlsx"; let body = """# Q3 operating budget

| Category | Planned | Actual | Variance |
| :--- | ---: | ---: | ---: |
| Research | 24000 | 22000 | 2000 |
| Delivery | 31000 | 33600 | -2600 |
| Support | 12000 | 10800 | 1200 |
""";
p=_lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let d=xlsx.create(${output}); d.sheet_from_markdown_table("Budget",${body}); d.save();
end _lmcode_
savedsl(p,output+".dslb"); r=system(concat(dsl_cli(p),["--dsl",output+".dslb"]),120000); assert(r.code==0);
