# Contact workbook authored from quoted CSV.
output = ARGV.len() > 0 ? ARGV[0] : "markdown-contacts-csv.xlsx"; let body = """Name,Company,Email,Active
\"Ada, Example\",Northstar Studio,ada@example.test,true
Rowan Price,Blue Orchard Labs,rowan@example.test,false
Maya Chen,Juniper Works,maya@example.test,true
""";
# host dependency: cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@v0.1.31"
schema_p = load_schema(schema="../schema/xlsx.dsl.json");
p = _lmcode_ schema_p;
let d=xlsx.create(${output}); d.sheet_from_csv("Contacts",${body}); d.save();
end _lmcode_
r = run_lmcode(p, {command:["lmoffice","xlsx","--lmcode","$DSLFILE"]}); assert(r.ok);
