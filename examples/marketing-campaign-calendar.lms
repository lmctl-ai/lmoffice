# Campaign launch calendar with channels, owners and planned spend All names and figures are fictional.
output = ARGV.len() > 0 ? ARGV[0] : "marketing-campaign-calendar.xlsx";
image = output + ".png";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let s = book.sheet("Campaigns");
s.merge(1,1,1,6).set(1,1,"November campaign calendar").bold(1,1).font_size(1,1,18.0).font_color(1,1,"#FFFFFF").fill(1,1,"#173D55").row_height(1,34.0);
s.merge(2,1,2,6).set(2,1,"Cedar Harbor Group | Planning edition | October 2026").font_color(2,1,"#526675").row_height(2,25.0);
s.col_width(1,18.0).set(4,1,"Launch").bold(4,1).fill(4,1,"#D9EAF0").wrap(4,1,true);
s.col_width(2,29.0).set(4,2,"Campaign").bold(4,2).fill(4,2,"#D9EAF0").wrap(4,2,true);
s.col_width(3,20.0).set(4,3,"Channel").bold(4,3).fill(4,3,"#D9EAF0").wrap(4,3,true);
s.col_width(4,28.0).set(4,4,"Asset").bold(4,4).fill(4,4,"#D9EAF0").wrap(4,4,true);
s.col_width(5,18.0).set(4,5,"Owner").bold(4,5).fill(4,5,"#D9EAF0").wrap(4,5,true);
s.col_width(6,18.0).set(4,6,"Budget").bold(4,6).fill(4,6,"#D9EAF0").wrap(4,6,true);
s.row_height(4,30.0);
s.row_height(5,28.0);
s.set(5,1,"Nov 02").wrap(5,1,true).fill(5,1,"#F0F5F7");
s.set(5,2,"Winter welcome").wrap(5,2,true).fill(5,2,"#F0F5F7");
s.set(5,3,"Email").wrap(5,3,true).fill(5,3,"#F0F5F7");
s.set(5,4,"Welcome sequence").wrap(5,4,true).fill(5,4,"#F0F5F7");
s.set(5,5,"Avery").wrap(5,5,true).fill(5,5,"#F0F5F7");
s.set(5,6,1800).wrap(5,6,true).fill(5,6,"#F0F5F7");
s.number_format(5,6,"$#,##0;[Red]($#,##0)");
s.row_height(6,28.0);
s.set(6,1,"Nov 05").wrap(6,1,true).fill(6,1,"#FFFFFF");
s.set(6,2,"Field notes").wrap(6,2,true).fill(6,2,"#FFFFFF");
s.set(6,3,"Blog").wrap(6,3,true).fill(6,3,"#FFFFFF");
s.set(6,4,"Customer interview").wrap(6,4,true).fill(6,4,"#FFFFFF");
s.set(6,5,"Morgan").wrap(6,5,true).fill(6,5,"#FFFFFF");
s.set(6,6,2400).wrap(6,6,true).fill(6,6,"#FFFFFF");
s.number_format(6,6,"$#,##0;[Red]($#,##0)");
s.row_height(7,28.0);
s.set(7,1,"Nov 09").wrap(7,1,true).fill(7,1,"#F0F5F7");
s.set(7,2,"Partner spotlight").wrap(7,2,true).fill(7,2,"#F0F5F7");
s.set(7,3,"Webinar").wrap(7,3,true).fill(7,3,"#F0F5F7");
s.set(7,4,"Demo and Q&A").wrap(7,4,true).fill(7,4,"#F0F5F7");
s.set(7,5,"Jules").wrap(7,5,true).fill(7,5,"#F0F5F7");
s.set(7,6,5200).wrap(7,6,true).fill(7,6,"#F0F5F7");
s.number_format(7,6,"$#,##0;[Red]($#,##0)");
s.row_height(8,28.0);
s.set(8,1,"Nov 12").wrap(8,1,true).fill(8,1,"#FFFFFF");
s.set(8,2,"Better workflows").wrap(8,2,true).fill(8,2,"#FFFFFF");
s.set(8,3,"Search").wrap(8,3,true).fill(8,3,"#FFFFFF");
s.set(8,4,"Landing page").wrap(8,4,true).fill(8,4,"#FFFFFF");
s.set(8,5,"Riley").wrap(8,5,true).fill(8,5,"#FFFFFF");
s.set(8,6,7400).wrap(8,6,true).fill(8,6,"#FFFFFF");
s.number_format(8,6,"$#,##0;[Red]($#,##0)");
s.row_height(9,28.0);
s.set(9,1,"Nov 18").wrap(9,1,true).fill(9,1,"#F0F5F7");
s.set(9,2,"Community lab").wrap(9,2,true).fill(9,2,"#F0F5F7");
s.set(9,3,"Event").wrap(9,3,true).fill(9,3,"#F0F5F7");
s.set(9,4,"Workshop kit").wrap(9,4,true).fill(9,4,"#F0F5F7");
s.set(9,5,"Sam").wrap(9,5,true).fill(9,5,"#F0F5F7");
s.set(9,6,3600).wrap(9,6,true).fill(9,6,"#F0F5F7");
s.number_format(9,6,"$#,##0;[Red]($#,##0)");
s.row_height(10,28.0);
s.set(10,1,"Nov 24").wrap(10,1,true).fill(10,1,"#FFFFFF");
s.set(10,2,"Quarter recap").wrap(10,2,true).fill(10,2,"#FFFFFF");
s.set(10,3,"Social").wrap(10,3,true).fill(10,3,"#FFFFFF");
s.set(10,4,"Results carousel").wrap(10,4,true).fill(10,4,"#FFFFFF");
s.set(10,5,"Robin").wrap(10,5,true).fill(10,5,"#FFFFFF");
s.set(10,6,1600).wrap(10,6,true).fill(10,6,"#FFFFFF");
s.number_format(10,6,"$#,##0;[Red]($#,##0)");
s.border_box(4,1,10,6,"thin","#BCCDD5").freeze(4,0).fit_to_page(1,1).page_orientation("landscape");
s.autofilter(4,1,10,6);
book.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--lmcode", output + ".dslb"]), 120000); assert(r.code == 0);
