# Fictional customer case study.
output = ARGV.len() > 0 ? ARGV[0] : "marketing-case-study.docx";
p=_lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
let d=docx.create(${output}); d.title("Northstar Case Study").author("Blue Finch Studio").font("Aptos").font_size(11.0).margins(54.0,54.0,54.0,54.0); d.heading_numbering(true); d.heading("How Northstar made planning visible",1).color("#17324D"); d.paragraph("A fictional customer story · Blue Finch Studio · October 2027").italic(true); d.heading("The challenge",2); d.paragraph("Northstar Academy had strong teachers and a growing after-school program, but planning lived in disconnected documents. Leaders needed a shared view without adding another meeting."); d.heading("The approach",2); d.paragraph("The team mapped the weekly planning rhythm, tested a single dashboard with three grade-level leads, and published a short decision record after each experiment."); let t=d.table(6,3); t.cell(1,1,"Measure").cell(1,2,"Before").cell(1,3,"After 90 days").cell(2,1,"Planning handoff").cell(2,2,"2–3 days").cell(2,3,"Same day").cell(3,1,"Status meetings").cell(3,2,"Weekly, 60 min").cell(3,3,"Biweekly, 30 min").cell(4,1,"Shared templates").cell(4,2,"4 versions").cell(4,3,"1 maintained set").cell(5,1,"Teacher adoption").cell(5,2,"Informal").cell(5,3,"31 active users").cell(6,1,"Open decisions").cell(6,2,"Hard to find").cell(6,3,"Visible by owner").borders(true).shade(1,1,"#D9EAF7"); d.heading("What changed",2); d.bullet("Leads can see the same current plan before a review."); d.bullet("Teachers spend less time reconciling duplicate dates."); d.bullet("Leaders can distinguish a late task from an unresolved decision."); d.heading("A practical lesson",2); d.paragraph("The strongest improvement came from naming an owner for every decision and keeping the first version small. Northstar plans to extend the rhythm to family events next term."); d.signature("Asha Patel, fictional program director"); d.header_fields("Blue Finch Studio | {PAGE} of {NUMPAGES}").save();
end _lmcode_
savedsl(p,output+".dslb"); r=system(concat(dsl_cli(p),["--lmcode",output+".dslb"]),120000); assert(r.code==0);
