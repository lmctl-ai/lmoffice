# Fictional content plan.
output = ARGV.len() > 0 ? ARGV[0] : "marketing-content-plan.docx";
p=_lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
let d=docx.create(${output}); d.title("Autumn Content Plan").author("Blue Finch Studio").font("Aptos").font_size(10.5).margins(48.0,48.0,48.0,48.0); d.heading("Autumn content plan",1).color("#17324D"); d.paragraph("Campaign: Make room for better work · September–November 2027 · Owner: Blue Finch Studio"); let t=d.table(7,5); t.cell(1,1,"Week").cell(1,2,"Channel").cell(1,3,"Story").cell(1,4,"CTA").cell(1,5,"Owner").cell(2,1,"Sep 6").cell(2,2,"Newsletter").cell(2,3,"Five-minute reset").cell(2,4,"Download guide").cell(2,5,"Asha").cell(3,1,"Sep 20").cell(3,2,"Blog").cell(3,3,"Meeting design").cell(3,4,"Read case study").cell(3,5,"Noah").cell(4,1,"Oct 4").cell(4,2,"Video").cell(4,3,"Desk setup tour").cell(4,4,"Watch series").cell(4,5,"Asha").cell(5,1,"Oct 18").cell(5,2,"Social").cell(5,3,"Team ritual cards").cell(5,4,"Save carousel").cell(5,5,"Mina").cell(6,1,"Nov 1").cell(6,2,"Webinar").cell(6,3,"Quarterly planning").cell(6,4,"Register").cell(6,5,"Noah").cell(7,1,"Nov 15").cell(7,2,"Customer story").cell(7,3,"Northstar interview").cell(7,4,"Talk to us").cell(7,5,"Mina").borders(true).shade(1,1,"#D9EAF7"); d.heading("Editorial guardrails",2);  d.paragraph("Use specific examples, name the tradeoff, and make every claim reviewable. Fictional customer details are clearly labeled in drafts."); d.paragraph("Measure qualified sign-ups and useful replies. Avoid vanity reach as a primary success metric. Keep screenshots accessible and captions concise."); d.header_fields("Blue Finch Studio | {PAGE}/{NUMPAGES}").save();
end _lmcode_
savedsl(p,output+".dslb"); r=system(concat(dsl_cli(p),["--dsl",output+".dslb"]),120000); assert(r.code==0);
