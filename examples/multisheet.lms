# A workbook split into assumptions, data, and summary sheets.
output = ARGV.len() > 0 ? ARGV[0] : "multisheet.xlsx";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let assumptions = book.sheet("Assumptions");
assumptions.set(1, 1, "Tax rate").set(1, 2, 0.21).number_format(1, 2, "0.0%");
let data = book.sheet("Data");
data.set(1, 1, "Month").set(1, 2, "Revenue").set(1, 3, "Cost");
data.set(2, 1, "Jan").set(2, 2, 12000.0).set(2, 3, 7000.0);
data.set(3, 1, "Feb").set(3, 2, 13500.0).set(3, 3, 7600.0);
data.set(6, 1, "Approved").set(6, 2, true).set(7, 1, "Revision").set(7, 2, 3);
data.set(4, 1, "Mar").set(4, 2, 15000.0).set(4, 3, 8100.0);
let summary = book.sheet("Summary");
summary.set(1, 1, "Quarter summary").bold(1, 1);
summary.set(2, 1, "Revenue").formula(2, 2, "SUM(Data!B2:B4)");
summary.set(3, 1, "Cost").formula(3, 2, "SUM(Data!C2:C4)");
summary.set(4, 1, "Profit").formula(4, 2, "B2-B3");
summary.set(5, 1, "After tax").formula(5, 2, "B4*(1-Assumptions!B1)");
summary.col_width(1, 24.0).col_width(2, 18.0).freeze(2, 1);
book.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--dsl", output + ".dslb"]), 120000);
assert(r.code == 0);
