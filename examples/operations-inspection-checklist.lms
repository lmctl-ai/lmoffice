# Fictional facility inspection checklist.
output = ARGV.len() > 0 ? ARGV[0] : "operations-inspection-checklist.docx";
p=_lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
let d=docx.create(${output}); d.title("Facility Inspection Checklist").author("Harborline Properties").font("Aptos").font_size(10.5).margins(48.0,48.0,48.0,48.0); d.heading("Quarterly facility inspection",1).color("#17324D"); d.paragraph("Site: Harbor Avenue · Inspector: Mara Ellis · Date: __________ · Weather: __________"); let t=d.table(7,4); t.cell(1,1,"Area").cell(1,2,"Check").cell(1,3,"Status").cell(1,4,"Action / owner").cell(2,1,"Roof access").cell(2,2,"Door, ladder, signage").cell(2,3,"Pass / fail").cell(2,4,"________________").cell(3,1,"Electrical").cell(3,2,"Panels clear and labeled").cell(3,3,"Pass / fail").cell(3,4,"________________").cell(4,1,"Life safety").cell(4,2,"Exits and extinguishers").cell(4,3,"Pass / fail").cell(4,4,"________________").cell(5,1,"Restrooms").cell(5,2,"Fixtures and supplies").cell(5,3,"Pass / fail").cell(5,4,"________________").cell(6,1,"Loading bay").cell(6,2,"Dock, rails, lighting").cell(6,3,"Pass / fail").cell(6,4,"________________").cell(7,1,"Common areas").cell(7,2,"Floors, walls, access").cell(7,3,"Pass / fail").cell(7,4,"________________").borders(true).shade(1,1,"#D9EAF7"); d.heading("Immediate hazards",2); d.paragraph("Record location, temporary control, and escalation contact. Do not close an incident without a photo or work-order reference."); d.paragraph("Inspector signature: ____________________   Manager review: ____________________"); d.header_fields("Harborline Properties | {PAGE}/{NUMPAGES}").save();
end _lmcode_
savedsl(p,output+".dslb"); r=system(concat(dsl_cli(p),["--lmcode",output+".dslb"]),120000); assert(r.code==0);
