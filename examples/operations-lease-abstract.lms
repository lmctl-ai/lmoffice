# Fictional lease abstract.
output = ARGV.len() > 0 ? ARGV[0] : "operations-lease-abstract.docx";
p=_lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
let d=docx.create(${output}); d.title("Lease Abstract").author("Harborline Properties").font("Aptos").font_size(10.5).margins(48.0,48.0,48.0,48.0); d.heading("Lease abstract",1).color("#17324D"); d.paragraph("Property: 240 Harbor Avenue, Suite 600 · Tenant: Cedar Peak Analytics · Abstract date: July 2027"); let t=d.table(7,2); t.cell(1,1,"Term").cell(1,2,"Detail").cell(2,1,"Commencement").cell(2,2,"October 1, 2027").cell(3,1,"Expiration").cell(3,2,"September 30, 2032").cell(4,1,"Area").cell(4,2,"18,400 rentable square feet").cell(5,1,"Base rent").cell(5,2,"$48.00 / square foot, year one").cell(6,1,"Escalation").cell(6,2,"2.75% each anniversary").cell(7,1,"Options").cell(7,2,"One five-year renewal").borders(true).shade(1,1,"#D9EAF7").shade(1,2,"#D9EAF7"); d.heading("Operating obligations",2); d.paragraph("Tenant maintains interior systems and janitorial service. Owner maintains structure, roof, and shared mechanical systems. Insurance certificates are due before possession."); d.heading("Review items",2); d.bullet("Confirm renewal notice deadline with legal."); d.bullet("Verify operating expense reconciliation method."); d.bullet("Attach the approved premises plan."); d.section_break("landscape"); d.heading("Contacts",2); d.paragraph("Owner representative: Mara Ellis · Tenant representative: Priya Nandakumar · Property manager: Harborline Service Desk"); d.header_fields("Harborline Properties | {PAGE}/{NUMPAGES}").save();
end _lmcode_
savedsl(p,output+".dslb"); r=system(concat(dsl_cli(p),["--dsl",output+".dslb"]),120000); assert(r.code==0);
