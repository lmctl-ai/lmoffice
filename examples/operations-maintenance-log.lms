# Asset service history, next due dates and priority icons All names and figures are fictional.
output = ARGV.len() > 0 ? ARGV[0] : "operations-maintenance-log.xlsx";
image = output + ".png";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let s = book.sheet("Maintenance");
s.merge(1,1,1,6).set(1,1,"Facilities / preventive maintenance").bold(1,1).font_size(1,1,18.0).font_color(1,1,"#FFFFFF").fill(1,1,"#173D55").row_height(1,34.0);
s.merge(2,1,2,6).set(2,1,"Cedar Harbor Group | Planning edition | October 2026").font_color(2,1,"#526675").row_height(2,25.0);
s.col_width(1,26.0).set(4,1,"Asset").bold(4,1).fill(4,1,"#D9EAF0").wrap(4,1,true);
s.col_width(2,24.0).set(4,2,"Location").bold(4,2).fill(4,2,"#D9EAF0").wrap(4,2,true);
s.col_width(3,22.0).set(4,3,"Last service").bold(4,3).fill(4,3,"#D9EAF0").wrap(4,3,true);
s.col_width(4,22.0).set(4,4,"Next due").bold(4,4).fill(4,4,"#D9EAF0").wrap(4,4,true);
s.col_width(5,16.0).set(4,5,"Priority").bold(4,5).fill(4,5,"#D9EAF0").wrap(4,5,true);
s.col_width(6,22.0).set(4,6,"Owner").bold(4,6).fill(4,6,"#D9EAF0").wrap(4,6,true);
s.row_height(4,30.0);
s.row_height(5,28.0);
s.set(5,1,"Air handler AH-02").wrap(5,1,true).fill(5,1,"#F0F5F7");
