# Weekly project status report with RAG health badges, milestone table, and velocity chart.
output = ARGV.len() > 0 ? ARGV[0] : "project_status.pptx";
p = _lmcode_ cli="lmoffice pptx" install="github:lmctl-ai/lmoffice@latest";
let deck = pptx.create(${output});
deck.theme("#1F4E78", "#548235", "Segoe UI", "Calibri");

# Slide 1: Title
let s1 = deck.slide();
s1.title_slide("Project Apollo Status", "Sprint 26 Progress, Milestones & Release Readiness\nWeek Ending: October 24, 2026");
s1.footer("Apollo Core Program | Confidential");
s1.transition("fade");

# Slide 2: RAG Status Badges
let s2 = deck.slide();
s2.title("Program Health Overview (RAG Status)");
s2.rounded_rect(80.0, 160.0, 260.0, 150.0, "#385723", "Overall Status: GREEN\nOn track for GA launch on November 18, 2026");
s2.rounded_rect(360.0, 160.0, 260.0, 150.0, "#385723", "Scope & Deliverables\nAll P0 and P1 user stories merged to main branch");
s2.rounded_rect(640.0, 160.0, 260.0, 150.0, "#ED7D31", "Timeline: AMBER\nThird-party penetration testing delayed by 3 business days");
s2.rounded_rect(920.0, 160.0, 260.0, 150.0, "#385723", "Budget & Spend\nUnder forecast by 4.2% across infrastructure allocations");
s2.text(80.0, 360.0, 1100.0, 60.0, "Executive takeaway: Core functionality is complete and stable; QA focus is now on performance under load.");
s2.footer("Apollo Core Program | Confidential");
s2.slide_number(true);

# Slide 3: Milestone Progress Table
let s3 = deck.slide();
s3.title("Key Deliverable Milestones");
let tbl = s3.table(80.0, 150.0, 1120.0, 260.0, 5, 4);
tbl.header_row("#1F4E78", "#FFFFFF");
tbl.cell(1, 1, "Milestone Deliverable").cell(1, 2, "Lead").cell(1, 3, "Target Date").cell(1, 4, "Current Status");
tbl.cell(2, 1, "Data Ingestion Pipeline V2").cell(2, 2, "Maya L.").cell(2, 3, "Oct 10, 2026").cell(2, 4, "Complete (Shipped)");
tbl.cell(3, 1, "Multi-Region Cluster Federation").cell(3, 2, "Alex K.").cell(3, 3, "Oct 22, 2026").cell(3, 4, "Complete (Shipped)");
tbl.cell(4, 1, "SOC 2 Type II Final Report").cell(4, 2, "Auditor").cell(4, 3, "Nov 02, 2026").cell(4, 4, "In Progress (90%)");
tbl.cell(5, 1, "Customer Canary Rollout").cell(5, 2, "DevOps").cell(5, 3, "Nov 15, 2026").cell(5, 4, "On Track");
s3.footer("Apollo Core Program | Confidential");
s3.slide_number(true);

# Slide 4: Sprint Velocity Chart
let s4 = deck.slide();
s4.title("Engineering Sprint Velocity (Story Points)");
s4.bar_chart(100.0, 140.0, 1080.0, 460.0, "Completed Story Points per Sprint", "Sprint 22,Sprint 23,Sprint 24,Sprint 25,Sprint 26", "Points", "48,54,58,62,65");
s4.footer("Apollo Core Program | Confidential");
s4.slide_number(true);

# Slide 5: Risks & Mitigations
let s5 = deck.slide();
s5.section_header("Risks & Mitigation Plan", "Mitigation: Added dedicated security liaison to expedite compliance sign-off without slipping GA date.", "#1F4E78");
s5.footer("Apollo Core Program | Confidential");
s5.slide_number(true);

deck.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--dsl", output + ".dslb"]), 120000);
assert(r.code == 0);
