# A small project report with a generated image and a table.
output = ARGV.len() > 0 ? ARGV[0] : "report.docx";
image = output + ".png";
p = _lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
docx.sample_image(${image});
let doc = docx.create(${output});
doc.title("Quarterly report").author("Lattice Systems");
doc.heading("Quarterly report", 1).bold(true).color("#17324D");
doc.paragraph("A compact report generated entirely by the lmoffice host.").italic(true);
doc.heading("Highlights", 2);
doc.bullet("Revenue grew 18 percent");
doc.bullet("Support response time fell below one hour");
let t = doc.table(3, 2);
t.cell(1, 1, "Metric").cell(1, 2, "Value");
t.cell(2, 1, "Revenue").cell(2, 2, "$128,000");
t.cell(3, 1, "Customers").cell(3, 2, "416");
doc.image(${image}, 160, 100).page_break();
doc.header("Lattice Systems").footer("Confidential").save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--dsl", output + ".dslb"]), 120000);
assert(r.code == 0);
