# Targeted cover letter for a fictional customer success role.
output = ARGV.len() > 0 ? ARGV[0] : "resume-cover-letter.docx"; p=_lmcode_ cli="lmoffice docx" install="github:lmctl-ai/lmoffice@latest";
let d=docx.create(${output});
d.title("Cover Letter — Customer Success Director").author("Elena Ortiz").font("Calibri").font_size(10.0).margins(42.0,42.0,42.0,42.0);
d.paragraph("Elena Ortiz\n18 Alder Street · Madison, WI 53703\nelena.ortiz@example.com · (608) 555-0192");
d.paragraph("June 20, 2026").tab_stop(528.0,"right");
d.paragraph("Hiring Committee\nHarborline Devices\nMadison, WI");
d.heading("Customer Success Director",1);
d.paragraph("I am excited to apply for the Customer Success Director role at Harborline Devices. Your work making field equipment easier to maintain matches the thread in my career: translating customer friction into practical operating habits.");
d.paragraph("At Northwind Workshop, I grew the implementation team from four to eleven while reducing median onboarding time from nine weeks to six. I paired customer interviews with a simple health score that helped account teams act before renewals became urgent.");
d.paragraph("I would welcome a conversation about building that same feedback loop at Harborline. Thank you for considering my application.");
d.paragraph("Sincerely,\nElena Ortiz");
d.footer_fields("Elena Ortiz | {PAGE}/{NUMPAGES}").save();
end _lmcode_
savedsl(p,output+".dslb");
r=system(concat(dsl_cli(p),["--dsl",output+".dslb"]),120000); assert(r.code==0);
