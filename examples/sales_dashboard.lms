# Multi-sheet sales dashboard with pivot-like regional summaries, cross-sheet formulas, and charts.
output = ARGV.len() > 0 ? ARGV[0] : "sales_dashboard.xlsx";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});

# Sheet 1: Dashboard
let s = book.sheet("Dashboard");
s.tab_color("#2E75B6");
s.page_orientation("landscape");
s.fit_to_page(1, 1);

s.set(1, 1, "GLOBAL SALES PERFORMANCE DASHBOARD");
s.bold(1, 1);
s.font_size(1, 1, 16.0);
s.font_color(1, 1, "#1F4E78");

# KPI Cards
s.set(3, 1, "Total Annual Revenue").set(3, 3, "Total Units Sold").set(3, 5, "Average Deal Size");
s.bold(3, 1).bold(3, 3).bold(3, 5);
s.formula(4, 1, "SUM(F7:F10)").formula(4, 3, "SUM('Regional Data'!C2:C13)").formula(4, 5, "A4/C4");
s.bold(4, 1).bold(4, 3).bold(4, 5);
s.font_size(4, 1, 14.0).font_size(4, 3, 14.0).font_size(4, 5, 14.0);
s.number_format(4, 1, "$#,##0.00").number_format(4, 3, "#,##0").number_format(4, 5, "$#,##0.00");
s.fill(3, 1, "#D9E1F2").fill(3, 3, "#E2EFDA").fill(3, 5, "#FCE4D6");
s.fill(4, 1, "#D9E1F2").fill(4, 3, "#E2EFDA").fill(4, 5, "#FCE4D6");

# Regional Summary Table
s.set(6, 1, "Region").set(6, 2, "Q1").set(6, 3, "Q2").set(6, 4, "Q3").set(6, 5, "Q4").set(6, 6, "Full Year");
s.bold(6, 1).bold(6, 2).bold(6, 3).bold(6, 4).bold(6, 5).bold(6, 6);
s.fill(6, 1, "#1F4E78").fill(6, 2, "#1F4E78").fill(6, 3, "#1F4E78").fill(6, 4, "#1F4E78").fill(6, 5, "#1F4E78").fill(6, 6, "#1F4E78");
s.font_color(6, 1, "#FFFFFF").font_color(6, 2, "#FFFFFF").font_color(6, 3, "#FFFFFF").font_color(6, 4, "#FFFFFF").font_color(6, 5, "#FFFFFF").font_color(6, 6, "#FFFFFF");

s.set(7, 1, "North America").set(7, 2, 420000.0).set(7, 3, 465000.0).set(7, 4, 490000.0).set(7, 5, 540000.0).formula(7, 6, "SUM(B7:E7)");
s.set(8, 1, "EMEA").set(8, 2, 280000.0).set(8, 3, 310000.0).set(8, 4, 335000.0).set(8, 5, 360000.0).formula(8, 6, "SUM(B8:E8)");
s.set(9, 1, "Asia Pacific").set(9, 2, 195000.0).set(9, 3, 225000.0).set(9, 4, 260000.0).set(9, 5, 290000.0).formula(9, 6, "SUM(B9:E9)");
s.set(10, 1, "Latin America").set(10, 2, 110000.0).set(10, 3, 125000.0).set(10, 4, 140000.0).set(10, 5, 155000.0).formula(10, 6, "SUM(B10:E10)");

s.set(11, 1, "Total").formula(11, 2, "SUM(B7:B10)").formula(11, 3, "SUM(C7:C10)").formula(11, 4, "SUM(D7:D10)").formula(11, 5, "SUM(E7:E10)").formula(11, 6, "SUM(F7:F10)");
s.bold(11, 1).bold(11, 2).bold(11, 3).bold(11, 4).bold(11, 5).bold(11, 6);
s.fill(11, 1, "#D9E1F2").fill(11, 2, "#D9E1F2").fill(11, 3, "#D9E1F2").fill(11, 4, "#D9E1F2").fill(11, 5, "#D9E1F2").fill(11, 6, "#D9E1F2");

s.number_format(7, 2, "$#,##0").number_format(7, 3, "$#,##0").number_format(7, 4, "$#,##0").number_format(7, 5, "$#,##0").number_format(7, 6, "$#,##0");
s.number_format(8, 2, "$#,##0").number_format(8, 3, "$#,##0").number_format(8, 4, "$#,##0").number_format(8, 5, "$#,##0").number_format(8, 6, "$#,##0");
s.number_format(9, 2, "$#,##0").number_format(9, 3, "$#,##0").number_format(9, 4, "$#,##0").number_format(9, 5, "$#,##0").number_format(9, 6, "$#,##0");
s.number_format(10, 2, "$#,##0").number_format(10, 3, "$#,##0").number_format(10, 4, "$#,##0").number_format(10, 5, "$#,##0").number_format(10, 6, "$#,##0");
s.number_format(11, 2, "$#,##0").number_format(11, 3, "$#,##0").number_format(11, 4, "$#,##0").number_format(11, 5, "$#,##0").number_format(11, 6, "$#,##0");

s.col_width(1, 20.0).col_width(2, 14.0).col_width(3, 14.0).col_width(4, 14.0).col_width(5, 14.0).col_width(6, 16.0);
s.border_box(6, 1, 11, 6, "thin", "#BFBFBF");

# Chart of Regional Revenue
s.bar_chart(13, 1, 26, 6, "Annual Revenue by Region", "A7:A10", "F7:F10");

# Sheet 2: Regional Data
let s2 = book.sheet("Regional Data");
s2.tab_color("#548235");
s2.set(1, 1, "Region").set(1, 2, "Product").set(1, 3, "Units").set(1, 4, "Unit Price").set(1, 5, "Total Revenue");
s2.bold(1, 1).bold(1, 2).bold(1, 3).bold(1, 4).bold(1, 5);
s2.fill(1, 1, "#385723").fill(1, 2, "#385723").fill(1, 3, "#385723").fill(1, 4, "#385723").fill(1, 5, "#385723");
s2.font_color(1, 1, "#FFFFFF").font_color(1, 2, "#FFFFFF").font_color(1, 3, "#FFFFFF").font_color(1, 4, "#FFFFFF").font_color(1, 5, "#FFFFFF");

s2.set(2, 1, "North America").set(2, 2, "Cloud Enterprise").set(2, 3, 120).set(2, 4, 12000.0).formula(2, 5, "C2*D2");
s2.set(3, 1, "North America").set(3, 2, "Edge Gateway").set(3, 3, 340).set(3, 4, 1400.0).formula(3, 5, "C3*D3");
s2.set(4, 1, "EMEA").set(4, 2, "Cloud Enterprise").set(4, 3, 85).set(4, 4, 12000.0).formula(4, 5, "C4*D4");
s2.set(5, 1, "EMEA").set(5, 2, "Edge Gateway").set(5, 3, 180).set(5, 4, 1400.0).formula(5, 5, "C5*D5");
s2.set(6, 1, "Asia Pacific").set(6, 2, "Cloud Enterprise").set(6, 3, 60).set(6, 4, 12000.0).formula(6, 5, "C6*D6");
s2.set(7, 1, "Asia Pacific").set(7, 2, "Edge Gateway").set(7, 3, 150).set(7, 4, 1400.0).formula(7, 5, "C7*D7");
s2.set(8, 1, "Latin America").set(8, 2, "Cloud Enterprise").set(8, 3, 30).set(8, 4, 12000.0).formula(8, 5, "C8*D8");
s2.set(9, 1, "Latin America").set(9, 2, "Edge Gateway").set(9, 3, 90).set(9, 4, 1400.0).formula(9, 5, "C9*D9");

s2.number_format(2, 4, "$#,##0.00").number_format(3, 4, "$#,##0.00").number_format(4, 4, "$#,##0.00").number_format(5, 4, "$#,##0.00").number_format(6, 4, "$#,##0.00").number_format(7, 4, "$#,##0.00").number_format(8, 4, "$#,##0.00").number_format(9, 4, "$#,##0.00");
s2.number_format(2, 5, "$#,##0.00").number_format(3, 5, "$#,##0.00").number_format(4, 5, "$#,##0.00").number_format(5, 5, "$#,##0.00").number_format(6, 5, "$#,##0.00").number_format(7, 5, "$#,##0.00").number_format(8, 5, "$#,##0.00").number_format(9, 5, "$#,##0.00");
s2.col_width(1, 18.0).col_width(2, 22.0).col_width(3, 12.0).col_width(4, 15.0).col_width(5, 18.0);
s2.border_box(1, 1, 9, 5, "thin", "#BFBFBF");
s2.autofilter(1, 1, 9, 5);

book.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--dsl", output + ".dslb"]), 120000);
assert(r.code == 0);
