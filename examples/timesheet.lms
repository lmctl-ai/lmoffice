# Weekly engineering timesheet with daily hour itemization, overtime formulas, and project billing.
output = ARGV.len() > 0 ? ARGV[0] : "timesheet.xlsx";
p = _lmcode_ cli="lmoffice xlsx" install="github:lmctl-ai/lmoffice@latest";
let book = xlsx.create(${output});
let s = book.sheet("Timesheet");
s.tab_color("#4472C4");
s.page_orientation("landscape");
s.fit_to_page(1, 1);

# Header Title & Employee Info
s.set(1, 1, "WEEKLY EMPLOYEE TIMESHEET & BILLING");
s.bold(1, 1);
s.font_size(1, 1, 15.0);
s.font_color(1, 1, "#1F4E78");

s.set(3, 1, "Employee:").set(3, 2, "Elena Vasquez").set(3, 5, "Pay Period Ending:").merge(3, 5, 3, 7).set(3, 8, "2026-10-23").merge(3, 8, 3, 10);
s.set(4, 1, "Role:").set(4, 2, "Principal Engineer").set(4, 5, "Standard Rate:").merge(4, 5, 4, 7).set(4, 8, 95.0).merge(4, 8, 4, 10);
s.bold(3, 1).bold(3, 5).bold(4, 1).bold(4, 5);
s.number_format(4, 8, "$#,##0.00");

# Table Header
s.set(6, 1, "Project Code").set(6, 2, "Task Description").set(6, 3, "Mon").set(6, 4, "Tue").set(6, 5, "Wed").set(6, 6, "Thu").set(6, 7, "Fri").set(6, 8, "Total Hours").set(6, 9, "Bill Rate").set(6, 10, "Total Amount");
s.bold(6, 1).bold(6, 2).bold(6, 3).bold(6, 4).bold(6, 5).bold(6, 6).bold(6, 7).bold(6, 8).bold(6, 9).bold(6, 10);
s.fill(6, 1, "#1F4E78").fill(6, 2, "#1F4E78").fill(6, 3, "#1F4E78").fill(6, 4, "#1F4E78").fill(6, 5, "#1F4E78").fill(6, 6, "#1F4E78").fill(6, 7, "#1F4E78").fill(6, 8, "#1F4E78").fill(6, 9, "#1F4E78").fill(6, 10, "#1F4E78");
s.font_color(6, 1, "#FFFFFF").font_color(6, 2, "#FFFFFF").font_color(6, 3, "#FFFFFF").font_color(6, 4, "#FFFFFF").font_color(6, 5, "#FFFFFF").font_color(6, 6, "#FFFFFF").font_color(6, 7, "#FFFFFF").font_color(6, 8, "#FFFFFF").font_color(6, 9, "#FFFFFF").font_color(6, 10, "#FFFFFF");

# Projects
s.set(7, 1, "PRJ-ALPHA").set(7, 2, "Cloud Migration Core").set(7, 3, 5.0).set(7, 4, 4.5).set(7, 5, 5.0).set(7, 6, 6.0).set(7, 7, 4.0).formula(7, 8, "SUM(C7:G7)").set(7, 9, 95.0).formula(7, 10, "H7*I7");
s.set(8, 1, "PRJ-BETA").set(8, 2, "API Gateway Microservice").set(8, 3, 2.0).set(8, 4, 3.0).set(8, 5, 2.5).set(8, 6, 2.0).set(8, 7, 3.0).formula(8, 8, "SUM(C8:G8)").set(8, 9, 95.0).formula(8, 10, "H8*I8");
s.set(9, 1, "OPS-MAINT").set(9, 2, "Production Incident Response").set(9, 3, 1.0).set(9, 4, 1.0).set(9, 5, 1.5).set(9, 6, 1.0).set(9, 7, 1.5).formula(9, 8, "SUM(C9:G9)").set(9, 9, 95.0).formula(9, 10, "H9*I9");

# Totals Row
s.set(10, 1, "Daily Totals").formula(10, 3, "SUM(C7:C9)").formula(10, 4, "SUM(D7:D9)").formula(10, 5, "SUM(E7:E9)").formula(10, 6, "SUM(F7:F9)").formula(10, 7, "SUM(G7:G9)").formula(10, 8, "SUM(H7:H9)").formula(10, 10, "SUM(J7:J9)");
s.bold(10, 1).bold(10, 3).bold(10, 4).bold(10, 5).bold(10, 6).bold(10, 7).bold(10, 8).bold(10, 10);
s.fill(10, 1, "#D9E1F2").fill(10, 3, "#D9E1F2").fill(10, 4, "#D9E1F2").fill(10, 5, "#D9E1F2").fill(10, 6, "#D9E1F2").fill(10, 7, "#D9E1F2").fill(10, 8, "#D9E1F2").fill(10, 10, "#D9E1F2");

# Numbers & widths
s.number_format(7, 3, "0.0").number_format(7, 4, "0.0").number_format(7, 5, "0.0").number_format(7, 6, "0.0").number_format(7, 7, "0.0").number_format(7, 8, "0.0");
s.number_format(8, 3, "0.0").number_format(8, 4, "0.0").number_format(8, 5, "0.0").number_format(8, 6, "0.0").number_format(8, 7, "0.0").number_format(8, 8, "0.0");
s.number_format(9, 3, "0.0").number_format(9, 4, "0.0").number_format(9, 5, "0.0").number_format(9, 6, "0.0").number_format(9, 7, "0.0").number_format(9, 8, "0.0");
s.number_format(10, 3, "0.0").number_format(10, 4, "0.0").number_format(10, 5, "0.0").number_format(10, 6, "0.0").number_format(10, 7, "0.0").number_format(10, 8, "0.0");

s.number_format(7, 9, "$#,##0.00").number_format(8, 9, "$#,##0.00").number_format(9, 9, "$#,##0.00");
s.number_format(7, 10, "$#,##0.00").number_format(8, 10, "$#,##0.00").number_format(9, 10, "$#,##0.00").number_format(10, 10, "$#,##0.00");

s.col_width(1, 16.0).col_width(2, 30.0).col_width(3, 8.0).col_width(4, 8.0).col_width(5, 8.0).col_width(6, 8.0).col_width(7, 8.0).col_width(8, 14.0).col_width(9, 12.0).col_width(10, 16.0);
s.border_box(6, 1, 10, 10, "thin", "#BFBFBF");

book.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--dsl", output + ".dslb"]), 120000);
assert(r.code == 0);
