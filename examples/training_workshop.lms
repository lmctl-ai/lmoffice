# Technical training workshop deck with agenda cards, workflow diagram, lab table, and resource links.
output = ARGV.len() > 0 ? ARGV[0] : "training_workshop.pptx";
p = _lmcode_ cli="lmoffice pptx" install="github:lmctl-ai/lmoffice@latest";
let deck = pptx.create(${output});
deck.theme("#2F5597", "#1F4E78", "Segoe UI", "Calibri");

# Slide 1: Title
let s1 = deck.slide();
s1.title_slide("Cloud Native Security Workshop", "Hands-on Architecture, Zero-Trust Policies, and Threat Modeling\nEngineering Training Series 2026");
s1.footer("Platform Engineering Workshop Series");
s1.transition("fade");

# Slide 2: Agenda
let s2 = deck.slide();
s2.title("Workshop Agenda & Learning Objectives");
s2.rounded_rect(80.0, 150.0, 260.0, 170.0, "#2F5597", "Module 1\nIdentity & IAM\nFine-grained workload identity & OIDC tokens");
s2.rounded_rect(360.0, 150.0, 260.0, 170.0, "#41719C", "Module 2\nNetwork Isolation\neBPF packet filtering & Cilium network policy");
s2.rounded_rect(640.0, 150.0, 260.0, 170.0, "#2E75B6", "Module 3\nSecrets & Encryption\nHashiCorp Vault & envelope KMS encryption");
s2.rounded_rect(920.0, 150.0, 260.0, 170.0, "#1F4E78", "Module 4\nIncident Response\nAutomated forensics & quarantine workflows");
s2.text(80.0, 360.0, 1100.0, 60.0, "Prerequisites: Laptop with Docker, kubectl configured to your sandbox cluster, and GitHub access.");
s2.footer("Platform Engineering Workshop Series");
s2.slide_number(true);

# Slide 3: Lab Architecture
let s3 = deck.slide();
s3.title("Hands-on Lab Exercise Pipeline");
s3.rounded_rect(80.0, 220.0, 200.0, 90.0, "#1F4E78", "Step 1\nDeploy Insecure App");
s3.arrow(300.0, 255.0, 60.0, 20.0, "#2F5597", 2.0);
s3.rounded_rect(380.0, 220.0, 200.0, 90.0, "#2F5597", "Step 2\nExecute Red Attack");
s3.arrow(600.0, 255.0, 60.0, 20.0, "#2F5597", 2.0);
s3.rounded_rect(680.0, 220.0, 200.0, 90.0, "#41719C", "Step 3\nEnforce Policy Rule");
s3.arrow(900.0, 255.0, 60.0, 20.0, "#2F5597", 2.0);
s3.rounded_rect(980.0, 220.0, 200.0, 90.0, "#548235", "Step 4\nVerify Threat Block");
s3.text(80.0, 380.0, 1100.0, 60.0, "Each participant works in an isolated sandbox namespace with automated grading scripts.");
s3.footer("Platform Engineering Workshop Series");
s3.slide_number(true);

# Slide 4: Schedule Table
let s4 = deck.slide();
s4.title("Detailed Training Schedule");
let tbl = s4.table(80.0, 150.0, 1120.0, 260.0, 5, 4);
tbl.header_row("#2F5597", "#FFFFFF");
tbl.cell(1, 1, "Time").cell(1, 2, "Session / Topic").cell(1, 3, "Activity Type").cell(1, 4, "Key Deliverable");
tbl.cell(2, 1, "09:00 - 10:15").cell(2, 2, "Identity & Cryptographic Workload Auth").cell(2, 3, "Lecture + Lab 1").cell(2, 4, "SPIFFE/SPIRE token verified");
tbl.cell(3, 1, "10:30 - 11:45").cell(3, 2, "Zero-Trust Network Policies & eBPF").cell(3, 3, "Lecture + Lab 2").cell(3, 4, "Egress lockdown enforced");
tbl.cell(4, 1, "01:00 - 02:15").cell(4, 2, "KMS Envelope Secrets Management").cell(4, 3, "Lecture + Lab 3").cell(4, 4, "Automated cert rotation active");
tbl.cell(5, 1, "02:30 - 04:00").cell(5, 2, "Live Fire Red Team & Defense Drill").cell(5, 3, "Cap-stone Challenge").cell(5, 4, "Incident mitigated < 5 mins");
s4.footer("Platform Engineering Workshop Series");
s4.slide_number(true);

# Slide 5: Resources & Links
let s5 = deck.slide();
s5.title("Workshop Reference Materials & Code");
s5.text(80.0, 160.0, 1100.0, 50.0, "All lab materials, Terraform scripts, and solutions are maintained online:");
s5.hyperlink(80.0, 230.0, 500.0, 40.0, "Lab Repository: github.com/novaterra/cloud-sec-workshop", "https://github.com/novaterra/cloud-sec-workshop");
s5.hyperlink(80.0, 290.0, 500.0, 40.0, "Interactive Sandbox Cluster Login", "https://sandbox.novaterra.internal");
s5.hyperlink(80.0, 350.0, 500.0, 40.0, "Slack Community: #cloud-security-training", "https://slack.novaterra.internal");
s5.footer("Platform Engineering Workshop Series");
s5.slide_number(true);

deck.save();
end _lmcode_
savedsl(p, output + ".dslb");
r = system(concat(dsl_cli(p), ["--dsl", output + ".dslb"]), 120000);
assert(r.code == 0);
